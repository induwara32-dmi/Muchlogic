---
import '../styles/global.css';
import SEO, { type SEOProps } from '../components/layout/SEO.astro';
import OrganizationJsonLd from '../components/layout/OrganizationJsonLd.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

type Props = SEOProps;

const seo = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} />
    <OrganizationJsonLd />
    <!-- Lets CSS hide scroll-reveal content only when JS can reveal it again -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="fixed left-4 top-3 z-50 -translate-y-20 rounded-control bg-dark px-5 py-3 text-sm font-semibold text-white transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      // Fade/slide-up for [data-reveal] elements. CSS disables this under prefers-reduced-motion.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        items.forEach((el) => observer.observe(el));
      }
    </script>

    <script>
      // Hero grid "flashlight": the highlighted grid follows the mouse pointer.
      // Cheap by design: only runs with a real mouse, only on .hero-bg, at most once per frame.
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canHover && !reduceMotion) {
        document.querySelectorAll<HTMLElement>('.hero-bg').forEach((hero) => {
          let frame = 0;
          let x = 0;
          let y = 0;
          const paint = () => {
            hero.style.setProperty('--mx', `${x}px`);
            hero.style.setProperty('--my', `${y}px`);
            frame = 0;
          };
          hero.addEventListener(
            'pointermove',
            (event) => {
              const box = hero.getBoundingClientRect();
              x = event.clientX - box.left;
              y = event.clientY - box.top;
              hero.setAttribute('data-active', '');
              if (!frame) frame = requestAnimationFrame(paint);
            },
            { passive: true },
          );
          hero.addEventListener('pointerleave', () => hero.removeAttribute('data-active'));
        });
      }
    </script>
  </body>
</html>
