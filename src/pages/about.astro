---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section, { type SectionTone } from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Icon from '../components/ui/Icon.astro';
import PageHero from '../components/sections/PageHero.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import TeamGrid from '../components/sections/TeamGrid.astro';
import SriLankaMap from '../components/sections/SriLankaMap.astro';
import CTABand from '../components/sections/CTABand.astro';
import { missionCards, reasons } from '../data/about';
import { team } from '../data/team';

// Alternate backgrounds over the sections that render (leadership hides while team.ts is empty)
const sectionOrder = [
  'mission',
  'process',
  ...(team.length > 0 ? ['team'] : []),
  'location',
  'reasons',
  'cta',
];
const tone = (key: string): SectionTone =>
  sectionOrder.indexOf(key) % 2 === 0 ? 'alt' : 'white';
---

<BaseLayout
  title="About"
  description="MuchLogic is a Sri Lankan software company building custom software, websites and AI tools for growing businesses, with real support after launch."
>
  <PageHero
    align="left"
    eyebrow="About MuchLogic"
    description="MuchLogic designs, builds and supports custom software, websites and AI tools for businesses that need things to work every day, with real support from a team that cares."
  >
    We build <span class="text-primary">smart software</span>{' '}
    <span class="text-muted">for businesses that want to grow.</span>
  </PageHero>

  <!-- What we believe -->
  <section class="bg-surface py-14 md:py-20" aria-labelledby="believe-title">
    <div data-reveal class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
        <h2 id="believe-title" class="text-[0.8125rem] font-semibold uppercase tracking-[0.12em] text-primary">
          What we believe
        </h2>
        <p class="border-l-2 border-primary pl-6 text-xl font-medium leading-snug tracking-heading text-ink md:text-2xl">
          We don’t build software just to look good in a demo. We build systems that businesses use
          every day: simple to run, secure, and supported long after launch.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <Section tone={tone('mission')} aria-labelledby="mission-title">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <Eyebrow>Our mission</Eyebrow>
        <h2
          id="mission-title"
          class="mt-3 text-section"
        >
          Practical technology, measured in real results
        </h2>
        <p class="mt-4 max-w-lg text-lead">
          We help businesses work faster, decide better and grow with confidence, using technology
          that fits how they already work.
        </p>
      </div>
      <ul class="grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2">
        {
          missionCards.map((card) => (
            <li data-reveal class="flex gap-4 bg-surface p-5 sm:block sm:p-7">
              <span class="icon-tile">
                <Icon name={card.icon} size={22} />
              </span>
              <div>
                <h3 class="text-base sm:mt-4 sm:text-lg">{card.title}</h3>
                <p class="mt-1">{card.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Process -->
  <Section tone={tone('process')} aria-labelledby="about-process-title">
    <SectionHeading id="about-process-title" eyebrow="How we deliver">
      From idea to launch, one clear path
    </SectionHeading>
    <ProcessSteps class="mt-10 lg:mt-12" />
  </Section>

  <!-- Leadership (only when team.ts has people) -->
  {
    team.length > 0 && (
      <Section tone={tone('team')} aria-labelledby="team-title">
        <SectionHeading id="team-title" eyebrow="Leadership">
          The people behind MuchLogic
        </SectionHeading>
        <TeamGrid class="mt-10 lg:mt-12" />
      </Section>
    )
  }

  <!-- From Sri Lanka -->
  <Section tone={tone('location')} aria-labelledby="location-title">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <Eyebrow>Built in Sri Lanka</Eyebrow>
        <h2
          id="location-title"
          class="mt-3 text-section"
        >
          From Sri Lanka, for businesses everywhere
        </h2>
        <div class="mt-4 max-w-lg space-y-5 text-lead">
          <p>
            MuchLogic is a Sri Lankan software company. We work closely with local businesses, and
            we understand how they buy, sell and grow.
          </p>
          <p>
            Our work is planned, built and supported online, so we can work with clients wherever
            they are.
          </p>
        </div>
      </div>
      <SriLankaMap />
    </div>
  </Section>

  <!-- Why businesses choose MuchLogic -->
  <Section tone={tone('reasons')} aria-labelledby="reasons-title">
    <SectionHeading id="reasons-title">
      Why businesses choose MuchLogic
    </SectionHeading>
    <ul class="mt-10 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3">
      {
        reasons.map((reason) => (
          <li data-reveal class="flex gap-4 border-t border-line pt-5">
            <Icon name="check" size={20} strokeWidth={2.5} class="mt-0.5 shrink-0 text-primary" />
            <div>
              <h3 class="text-lg">{reason.title}</h3>
              <p class="mt-1">{reason.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone={tone('cta')}>
    <CTABand layout="center" title="Let’s build what’s next, together." ctaLabel="Talk to our team" />
  </Section>
</BaseLayout>
