---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Icon from '../components/ui/Icon.astro';
import PageHero from '../components/sections/PageHero.astro';
import ServiceSubnav from '../components/sections/ServiceSubnav.astro';
import ServiceDetail from '../components/sections/ServiceDetail.astro';
import TechGrid from '../components/sections/TechGrid.astro';
import CTABand from '../components/sections/CTABand.astro';
import { services, servicePillars, serviceHeroTags } from '../data/services';

// The section after the last service continues the alternating backgrounds
const techTone = services.length % 2 === 0 ? 'white' : 'alt';
---

<BaseLayout
  title="Services"
  description="Custom software, MuchLogic POS, AI and automation, websites and e-commerce, mobile apps and brand marketing — planned, built and supported by one team in Sri Lanka."
>
  <PageHero
    eyebrow="Our services"
    description="From POS systems and custom software to AI tools, websites and mobile apps, we plan, build and support the software your business needs to run better and grow."
    tags={serviceHeroTags}
  >
    Services built <span class="text-muted">for your growth</span>
  </PageHero>

  <!-- One team intro -->
  <Section aria-labelledby="one-team-title" class="pt-0 md:pt-4">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <Eyebrow>What we do</Eyebrow>
        <h2
          id="one-team-title"
          class="mt-3 text-[2rem] leading-[1.15] tracking-display md:text-[2.625rem] lg:text-5xl"
        >
          One team for planning, building and growing
        </h2>
        <div class="mt-6 space-y-5 text-lg">
          <p>
            Instead of juggling a designer, a developer and a marketer, you work with one team
            that takes your project from first idea to launch, and stays with you after it.
          </p>
          <p>
            We start by understanding how your business works. Then we build software that fits
            it, and keep improving it as you grow.
          </p>
        </div>
      </div>

      <ul class="space-y-4">
        {
          servicePillars.map((pillar, i) => (
            <li
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
              class="flex gap-5 rounded-card bg-surface-alt p-6 sm:p-7"
            >
              <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-[10px] border border-line bg-surface text-primary">
                <Icon name={pillar.icon} size={22} />
              </span>
              <div>
                <h3 class="text-lg">{pillar.title}</h3>
                <p class="mt-1.5">{pillar.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Sticky chips stay pinned while scrolling through the service sections -->
  <div>
    <ServiceSubnav services={services} />
    {services.map((service, i) => <ServiceDetail service={service} index={i} />)}
  </div>

  <!-- Technologies -->
  <Section tone={techTone} aria-labelledby="tech-title">
    <SectionHeading
      id="tech-title"
      eyebrow="Technologies"
      align="center"
      description="Well-supported tools we use to build fast, reliable software."
    >
      Built with modern, proven tools
    </SectionHeading>
    <TechGrid class="mx-auto mt-12 max-w-5xl lg:mt-16" />
  </Section>

  <Section tone={techTone === 'alt' ? 'white' : 'alt'}>
    <CTABand
      layout="center"
      eyebrow="Let’s build together"
      title="Ready to turn your idea"
      subtitle="into a working product?"
      ctaLabel="Talk to our team"
    />
  </Section>
</BaseLayout>
