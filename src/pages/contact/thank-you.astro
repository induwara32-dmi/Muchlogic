---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
---

<BaseLayout
  title="Thank you"
  description="Thanks for contacting MuchLogic. We’ll get back to you within one business day."
  noindex
>
  <section class="bg-surface-alt py-14 md:py-24">
    <Container>
      <div class="mx-auto max-w-2xl rounded-card border border-line bg-surface px-6 py-12 text-center sm:px-12 sm:py-16">
        <span class="mx-auto inline-flex size-20 items-center justify-center rounded-pill bg-primary-soft text-primary">
          <Icon name="check" size={36} strokeWidth={2.5} />
        </span>
        <h1 class="mt-8 text-3xl font-extrabold leading-tight tracking-display sm:text-[2.75rem]">
          Thank you! Your message is on its way.
        </h1>
        <p class="mx-auto mt-4 max-w-md text-lg">
          We’ll get back to you within one business day.
        </p>
        <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/" size="lg" block>Back to home</Button>
          <Button href="/work" variant="secondary" size="lg" icon="arrow-right" block>See our work</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
