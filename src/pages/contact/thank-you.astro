---
import { siWhatsapp } from 'simple-icons';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { chatMessage, chatUrl } from '../../lib/whatsapp-chat';

// Without JS (or when opened directly) the button uses the generic message.
// With JS, the script below swaps in the visitor's details from sessionStorage.
const genericUrl = chatUrl(chatMessage(null));
---

<BaseLayout
  title="Thank you"
  description="Thanks for contacting MuchLogic. We’ll get back to you within one business day."
  noindex
>
  <section class="bg-surface-alt py-14 md:py-24">
    <Container>
      <div class="mx-auto max-w-2xl rounded-card border border-line bg-surface px-6 py-12 text-center shadow-card sm:px-12 sm:py-14">
        <span class="mx-auto inline-flex size-16 items-center justify-center rounded-pill bg-primary-soft text-primary">
          <Icon name="check" size={30} strokeWidth={2.5} />
        </span>
        <h1 class="mt-6 text-3xl font-extrabold leading-tight tracking-display sm:text-[2.75rem]">
          Thank you! Your message is on its way.
        </h1>
        <p class="mx-auto mt-4 max-w-md text-lead">
          We’ll get back to you within one business day.
        </p>

        <!-- WhatsApp backup: in case the popup was blocked or WhatsApp was closed -->
        <div class="mx-auto mt-8 max-w-md rounded-card border border-line bg-surface-alt px-5 py-6">
          <p data-wa-hint class="text-[0.9375rem] text-body">Prefer WhatsApp? Send us a message.</p>
          <a
            data-wa-link
            href={genericUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-4 inline-flex min-h-tap w-full items-center justify-center gap-2.5 rounded-control bg-primary px-6 text-[0.9375rem] font-medium text-white shadow-button-primary transition-colors hover:bg-primary-hover sm:w-auto"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="fill-current">
              <path d={siWhatsapp.path} />
            </svg>
            Send on WhatsApp{' '}
            <span class="sr-only">(opens WhatsApp in a new tab)</span>
          </a>
        </div>

        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/" variant="secondary" size="lg" block>Back to home</Button>
          <Button href="/work" variant="secondary" size="lg" icon="arrow-right" block>See our work</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  import { CHAT_STORAGE_KEY, chatMessage, chatUrl, type ChatDetails } from '../../lib/whatsapp-chat';

  // Details saved by the contact form just before it redirected here; read once, then removed
  let details: ChatDetails | null = null;
  try {
    const saved = sessionStorage.getItem(CHAT_STORAGE_KEY);
    sessionStorage.removeItem(CHAT_STORAGE_KEY);
    details = saved ? (JSON.parse(saved) as ChatDetails) : null;
  } catch {
    details = null;
  }

  if (details) {
    const link = document.querySelector<HTMLAnchorElement>('[data-wa-link]');
    const hint = document.querySelector<HTMLElement>('[data-wa-hint]');
    if (link) link.href = chatUrl(chatMessage(details));
    if (hint) hint.textContent = 'WhatsApp didn’t open? Send your details here.';
  }
</script>
