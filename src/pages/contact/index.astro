---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Icon from '../../components/ui/Icon.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ProcessSteps from '../../components/sections/ProcessSteps.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
import ContactCards from '../../components/sections/ContactCards.astro';
import FAQ from '../../components/sections/FAQ.astro';
import { nextSteps } from '../../data/contact';
import { locationLabel } from '../../data/site';
import { sriLankaOutline } from '../../components/sections/sriLankaOutline';
---

<BaseLayout
  title="Contact"
  description="Tell MuchLogic about your project: custom software, websites, AI automation, mobile apps or POS systems. We reply within one business day."
>
  <PageHero
    eyebrow="Contact us"
    visual="contact"
    description="Whether you have a clear project in mind or just want to explore what’s possible, we’ll help you work out the next steps."
  >
    Let’s build something <span class="text-muted">that works for you.</span>
  </PageHero>

  <!-- Form + what happens next -->
  <Section tone="alt" aria-labelledby="form-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-x-16 lg:gap-y-12">
      <div class="lg:col-start-1 lg:row-start-1">
        <Eyebrow>Get in touch</Eyebrow>
        <h2
          id="form-title"
          class="mt-3 text-section"
        >
          Tell us about <span class="text-primary">your project</span>
        </h2>
        <p class="mt-4 max-w-prose text-lead">
          Share a few details and we’ll come back with practical advice and a clear way forward.
        </p>
      </div>

      <ContactForm labelledBy="form-title" class="lg:col-start-2 lg:row-span-2 lg:row-start-1" />

      <div class="lg:col-start-1 lg:row-start-2">
        <h3 class="text-xl">What happens next</h3>
        <ProcessSteps items={nextSteps} layout="vertical" headingLevel="h4" class="mt-5" />
      </div>
    </div>
  </Section>

  <!-- Contact options -->
  <Section aria-labelledby="contact-options-title">
    <h2 id="contact-options-title" class="sr-only">Other ways to reach us</h2>
    <ContactCards />
    <!-- Location card with a small outline of the island (decorative) -->
    <div class="mt-10 flex max-w-xl items-center gap-5 rounded-card border border-line bg-surface-alt p-5 sm:p-6">
      <svg viewBox="0 0 249 419" class="h-20 w-auto shrink-0 text-primary sm:h-24" aria-hidden="true" fill="none">
        <path d={sriLankaOutline} class="fill-primary-soft" stroke="currentColor" stroke-width="6" stroke-linejoin="round" />
        <circle cx="125" cy="245" r="22" fill="currentColor" />
        <circle cx="125" cy="245" r="9" class="fill-white" />
      </svg>
      <div>
        <p class="flex items-center gap-2 text-lg font-semibold text-ink">
          <Icon name="map-pin" size={20} class="text-primary" />
          Based in {locationLabel}
        </p>
        <p class="mt-1">We work with clients across Sri Lanka and abroad, online.</p>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section tone="alt" aria-labelledby="faq-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <SectionHeading
        id="faq-title"
        description="Everything you need to know about working with us."
      >
        Questions we <span class="text-primary">often get</span>
      </SectionHeading>
      <FAQ />
    </div>
  </Section>
</BaseLayout>
