---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import StatsRow from '../components/sections/StatsRow.astro';
import ClientLogos from '../components/sections/ClientLogos.astro';
import NumberedCards from '../components/sections/NumberedCards.astro';
import ServiceCard from '../components/sections/ServiceCard.astro';
import ProjectSlider from '../components/sections/ProjectSlider.astro';
import BuiltWith from '../components/sections/BuiltWith.astro';
import HeroVisual from '../components/sections/HeroVisual.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { services } from '../data/services';
import { stats } from '../data/stats';
import { clientLogos } from '../data/clientLogos';
import { featuredProjects } from '../data/projects';
import { approvedTestimonials } from '../data/testimonials';
import { whyMuchLogic } from '../data/home';

// After the hero, backgrounds alternate over the sections that actually render,
// so hidden (empty) sections never leave two greys or two whites side by side.
const sectionOrder = [
  'why',
  'services',
  'work',
  'process',
  ...(approvedTestimonials.length > 0 ? ['testimonials'] : []),
];
const tone = (key: string): 'white' | 'alt' => (sectionOrder.indexOf(key) % 2 === 0 ? 'white' : 'alt');

// Credibility strip under the hero: only when there are real numbers or client logos to show
const showProof = stats.length > 0 || clientLogos.length > 0;
---

<BaseLayout
  title="Custom Software, Web & AI Solutions in Sri Lanka"
  description="MuchLogic builds custom software, websites, web platforms and AI automation for growing businesses, plus mobile apps and POS systems. Built in Sri Lanka."
>
  <!-- Hero -->
  <section
    class="hero-bg relative flex items-center overflow-hidden text-dark-muted md:min-h-[min(calc(100svh-4.5rem),54rem)]"
    aria-labelledby="hero-title"
  >
    <!-- Slow-drifting orange glow behind the headline (decorative) -->
    <div class="hero-glow" aria-hidden="true"></div>
    <Container class="py-14 md:py-24">
      <!--
        Entrance: eyebrow and buttons fade up; headline and lead (the LCP candidates) only rise
        slightly and stay visible from the first paint, so LCP isn't delayed.
      -->
      <div class="mx-auto max-w-5xl text-center">
        <Eyebrow onDark class="enter-fade">Built in Sri Lanka. Trusted worldwide.</Eyebrow>
        <h1
          id="hero-title"
          class="enter-rise mt-5 text-display font-extrabold text-white [--enter-delay:60ms]"
        >
          <!-- On large screens the highlighted phrase always stays together on line one -->
          <span class="lg:block">We build <span class="text-primary-on-dark">smart software and AI</span></span>{' '}
          that grows your business
        </h1>
        <p class="enter-rise mx-auto mt-6 max-w-prose text-lead [--enter-delay:120ms]">
          From custom web apps and business platforms to websites and AI tools, we design, build and
          support software that helps businesses work faster and grow.
        </p>
        <div class="enter-fade mt-9 flex flex-col justify-center gap-3 sm:flex-row [--enter-delay:200ms]">
          <Button href="/contact" size="lg" block>Start a project</Button>
          <Button href="/work" variant="on-dark" size="lg" block>See our work</Button>
        </div>
      </div>
      <!-- Decorative product visual, tablet and up; cropped by the hero's bottom edge -->
      <HeroVisual class="enter-fade mt-14 -mb-14 md:-mb-24 [--enter-delay:320ms]" />
    </Container>
  </section>

  <BuiltWith />

  {
    showProof && (
      <section class="border-b border-line bg-surface py-10 md:py-12" aria-label="MuchLogic at a glance">
        <Container class="space-y-10">
          <StatsRow />
          <ClientLogos />
        </Container>
      </section>
    )
  }

  <!-- Why MuchLogic -->
  <Section tone={tone('why')} aria-labelledby="why-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div data-reveal>
        <Eyebrow>Why MuchLogic</Eyebrow>
        <h2
          id="why-title"
          class="mt-3 text-section"
        >
          Software that works <span class="text-primary">as hard as you do</span>
        </h2>
        <p class="mt-4 max-w-md text-lead">
          We help growing businesses plan, build and improve the software they depend on. Clear
          thinking, solid engineering and real support after launch, all from one team.
        </p>
        <a
          href="/about"
          class="group mt-7 inline-flex min-h-tap items-center gap-1.5 font-semibold text-primary hover:text-primary-hover"
        >
          <span class="link-label">More about us</span>
          <Icon
            name="arrow-right"
            size={18}
            class="arrow-nudge"
          />
        </a>
      </div>
      <NumberedCards items={whyMuchLogic} />
    </div>
  </Section>

  <!-- Services -->
  <Section tone={tone('services')} class="dot-bg" aria-labelledby="services-title">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading id="services-title" eyebrow="Our services" class="max-w-xl">
        Solutions that <span class="text-primary">move you forward</span>
      </SectionHeading>
      <p class="max-w-md text-lead">
        Everything you need to run, sell and grow, built and supported by one team.
      </p>
    </div>

    <ul
      class="mt-10 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:mt-12 lg:grid-cols-3"
    >
      {
        services.map((service) => (
          <li class="bg-surface">
            <ServiceCard service={service} />
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Featured projects -->
  <Section tone={tone('work')} aria-labelledby="work-title">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading id="work-title" eyebrow="Our work" class="max-w-2xl">
        Recent projects we’re <span class="text-primary">proud of</span>
      </SectionHeading>
      <Button href="/work" variant="secondary" class="self-start sm:self-auto">
        All projects
      </Button>
    </div>

    <ProjectSlider projects={featuredProjects} class="mt-8 md:mt-10 lg:mt-12" />
  </Section>

  <!-- Process -->
  <Section tone={tone('process')} class="dot-bg [--glow-x:12%]" aria-labelledby="process-title">
    <SectionHeading id="process-title" eyebrow="Our process" class="max-w-2xl">
      How we bring ideas to <span class="text-primary">life</span>
    </SectionHeading>
    <ProcessSteps class="mt-8 lg:mt-12" />
  </Section>

  <Testimonials tone={tone('testimonials')} />

  <FinalCTA />
</BaseLayout>
