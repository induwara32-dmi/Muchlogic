---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';

const links: { label: string; description: string; href: string; icon: IconName }[] = [
  { label: 'Home', description: 'Start from the beginning', href: '/', icon: 'arrow-right' },
  { label: 'Services', description: 'What we build and support', href: '/services', icon: 'layers' },
  { label: 'Our Work', description: 'Projects we’ve shipped', href: '/work', icon: 'rocket' },
  { label: 'Contact', description: 'Tell us what you need', href: '/contact', icon: 'mail' },
];
---

<BaseLayout
  title="Page not found"
  description="Sorry, we couldn’t find that page. Head back to the MuchLogic homepage or explore our services and work."
  noindex
>
  <section class="soft-bg border-b border-line py-16 md:py-24" aria-labelledby="page-title">
    <Container>
      <p class="font-display text-7xl font-extrabold leading-none tracking-display text-primary md:text-8xl" aria-hidden="true">
        404
      </p>
      <h1 id="page-title" class="mt-6 max-w-2xl text-3xl font-extrabold leading-tight tracking-display md:text-5xl">
        This page took a wrong turn.
      </h1>
      <p class="mt-5 max-w-xl text-[1.0625rem] md:text-lg">
        The link may be old, or the page may have moved. Try one of these instead, or tell us what you
        were looking for.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href="/" size="lg" block>Back to home</Button>
        <Button href="/contact" variant="secondary" size="lg" block>Contact us</Button>
      </div>
    </Container>
  </section>

  <section class="py-12 md:py-16" aria-labelledby="helpful-links-title">
    <Container>
      <h2 id="helpful-links-title" class="text-xl">Helpful links</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="group flex h-full items-start gap-4 rounded-card border border-line bg-surface p-5 shadow-card transition-transform duration-200 hover:-translate-y-0.5"
              >
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary-soft text-primary">
                  <Icon name={link.icon} size={20} />
                </span>
                <span>
                  <span class="block font-semibold text-ink group-hover:text-primary">{link.label}</span>{' '}
                  <span class="block text-[0.9375rem]">{link.description}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</BaseLayout>
