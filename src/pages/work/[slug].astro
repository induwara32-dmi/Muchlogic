---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import WindowBar from '../../components/ui/WindowBar.astro';
import { projects, caseNumber, publicDetails, type Project } from '../../data/projects';
import { getService, techIcon } from '../../data/services';
import { getProjectImage } from '../../lib/images';

export const getStaticPaths = (() =>
  projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const details = publicDetails(project);
const number = caseNumber(project);
const image = getProjectImage(project.image);

const serviceTitles = project.services
  .map((slug) => getService(slug)?.title)
  .filter((title): title is string => Boolean(title));

const info = [
  { label: 'Client', value: details.client },
  { label: 'Industry', value: details.industry },
  { label: 'Services', value: serviceTitles.join(', ') || undefined },
].filter((row): row is { label: string; value: string } => Boolean(row.value));

// Previous / next wrap around so every case study links to two others
const index = projects.indexOf(project);
const previous = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];

const similarHref = project.services[0] ? `/contact?service=${project.services[0]}` : '/contact';

// Meta description: keep it within ~160 characters so search results don't cut it off
const META_MAX = 160;
const withSuffix = `${project.title} case study: ${project.summary} Built by MuchLogic in Sri Lanka.`;
const plain = `${project.title} case study: ${project.summary}`;
const metaDescription =
  project.seoDescription ?? (withSuffix.length <= META_MAX ? withSuffix : plain);
if (metaDescription.length > META_MAX) {
  // Never cut it off mid-sentence; flag it so a short `seoDescription` can be added in projects.ts
  console.warn(
    `[seo] /work/${project.slug}: meta description is ${metaDescription.length} characters. Add a shorter seoDescription in projects.ts.`,
  );
}

// Real screenshots become the share image; placeholders fall back to the default OG image
const ogImage = image.isPlaceholder
  ? undefined
  : (await getImage({ src: image.src, width: 1200, height: 630, format: 'jpg', fit: 'cover', position: project.imagePosition ?? 'top' })).src;

const headingBar = 'flex items-center gap-3 text-xl before:h-6 before:w-1 before:bg-primary before:content-[""]';
---

<BaseLayout
  title={`${project.title} — Case study`}
  description={metaDescription}
  image={ogImage}
  type="article"
>
  <article>
    <header class="bg-surface pt-8 md:pt-12">
      <Container>
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-body">
            <li><a href="/" class="inline-flex min-h-tap items-center transition-colors hover:text-ink">Home</a></li>
            <li aria-hidden="true"><Icon name="chevron-right" size={14} class="text-muted" /></li>
            <li><a href="/work" class="inline-flex min-h-tap items-center transition-colors hover:text-ink">Our Work</a></li>
            <li aria-hidden="true"><Icon name="chevron-right" size={14} class="text-muted" /></li>
            <li><a href={`/work/${project.slug}`} aria-current="page" class="inline-flex min-h-tap items-center font-medium text-ink">{project.title}</a></li>
          </ol>
        </nav>

        <div class="mt-10 max-w-3xl md:mt-14">
          <div class="flex flex-wrap items-center gap-3">
            <Badge>{project.category}</Badge>{' '}
            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-body">Case study {number}</span>{' '}
            {project.prototype && <Badge tone="outline">Prototype</Badge>}
          </div>
          <h1 class="mt-5 text-title font-extrabold">
            {project.title}
          </h1>
          <p class="mt-5 max-w-prose text-lead">{project.description}</p>
        </div>

        <div class="mt-10 overflow-hidden rounded-card border border-line bg-surface-alt shadow-card md:mt-14">
          {!image.isPlaceholder && <WindowBar class="h-8 px-4" />}
          <Image
            src={image.src}
            alt={image.isPlaceholder ? '' : project.imageAlt}
            width={1600}
            height={Math.round(1600 * (image.src.height / image.src.width))}
            {...!image.isPlaceholder && { widths: [800, 1200, 1600], sizes: '(min-width: 1200px) 1136px, 100vw' }}
            loading="eager"
            class:list={[
              'block w-full',
              // Placeholders get a shorter, cropped frame; real screenshots show in full
              image.isPlaceholder ? 'aspect-[16/10] object-cover sm:aspect-[21/9]' : 'h-auto',
            ]}
          />
        </div>
      </Container>
    </header>

    <section class="bg-surface py-12 md:py-16" aria-label="Project details">
      <Container>
        {
          info.length > 0 && (
            <dl
              class="grid gap-4 sm:grid-cols-[repeat(var(--cols),minmax(0,1fr))]"
              style={`--cols:${info.length}`}
            >
              {info.map((row) => (
                <div class="rounded-card border border-line bg-surface-alt px-6 py-5">
                  <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-body">{row.label}</dt>
                  <dd class="mt-1.5 text-lg font-semibold text-ink">{row.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          (details.whatWeDid.length > 0 || details.tech.length > 0) && (
            <div class="mt-12 grid gap-12 md:mt-16 lg:grid-cols-2 lg:gap-16">
              {details.whatWeDid.length > 0 && (
                <div>
                  <h2 class={headingBar}>What we did</h2>
                  <ul class="mt-6 space-y-4">
                    {details.whatWeDid.map((item) => (
                      <li class="flex items-start gap-3 text-lg">
                        <Icon name="check" size={20} strokeWidth={2.5} class="mt-1 text-primary" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {details.tech.length > 0 && (
                <div>
                  <h2 class={headingBar}>Tech stack</h2>
                  <ul class="mt-6 flex flex-wrap gap-3">
                    {details.tech.map((name) => {
                      const logo = techIcon(name);
                      return (
                        <li class="inline-flex min-h-11 items-center gap-2.5 rounded-control border border-line px-4 font-semibold text-ink">
                          {logo && (
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" style={`fill:#${logo.hex}`}>
                              <path d={logo.path} />
                            </svg>
                          )}
                          {name}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}
            </div>
          )
        }

        <div class="mt-12 flex flex-col gap-3 border-t border-line pt-10 sm:flex-row md:mt-16">
          {
            project.downloadUrl && (
              <Button href={project.downloadUrl} size="lg" icon="external-link" external block>
                Download from Microsoft Store
              </Button>
            )
          }
          {
            project.liveUrl && (
              <Button
                href={project.liveUrl}
                size="lg"
                variant={project.downloadUrl ? 'secondary' : 'primary'}
                icon="external-link"
                external
                block
              >
                Visit live site
              </Button>
            )
          }
          <Button
            href={similarHref}
            size="lg"
            variant={project.downloadUrl || project.liveUrl ? 'secondary' : 'primary'}
            icon="arrow-right"
            block
          >
            Start a similar project
          </Button>
        </div>
      </Container>
    </section>
  </article>

  <nav aria-label="More projects" class="bg-surface-alt py-12 md:py-16">
    <Container class="grid gap-4 sm:grid-cols-2">
      <a
        href={`/work/${previous.slug}`}
        rel="prev"
        class="group flex items-center gap-4 rounded-card border border-line bg-surface p-6 transition-colors duration-150 hover:border-ink/40"
      >
        <Icon name="arrow-left" size={20} class="arrow-nudge-back text-primary" />
        <span>
          <span class="block text-xs font-semibold uppercase tracking-[0.12em] text-body">Previous project<span class="sr-only">:</span></span>{' '}
          <span class="mt-1 block text-lg font-bold text-ink">{previous.title}</span>
        </span>
      </a>
      <a
        href={`/work/${next.slug}`}
        rel="next"
        class="group flex items-center justify-end gap-4 rounded-card border border-line bg-surface p-6 text-right transition-colors duration-150 hover:border-ink/40"
      >
        <span>
          <span class="block text-xs font-semibold uppercase tracking-[0.12em] text-body">Next project<span class="sr-only">:</span></span>{' '}
          <span class="mt-1 block text-lg font-bold text-ink">{next.title}</span>
        </span>
        <Icon name="arrow-right" size={20} class="arrow-nudge text-primary" />
      </a>
    </Container>
  </nav>
</BaseLayout>
