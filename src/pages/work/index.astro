---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ProjectGallery from '../../components/sections/ProjectGallery.astro';
import CTABand from '../../components/sections/CTABand.astro';
---

<BaseLayout
  title="Our Work"
  description="Projects by MuchLogic: websites, web platforms and software products we’ve designed, built and launched for businesses in Sri Lanka."
>
  <PageHero
    eyebrow="Our work"
    description="A look at the websites, web platforms and software products we’ve designed, built and launched."
  >
    Work built for <span class="text-muted">real businesses</span>
  </PageHero>

  <Section tone="alt" aria-labelledby="projects-title">
    <SectionHeading id="projects-title" class="mb-8">
      Stories from the work we ship
    </SectionHeading>
    <ProjectGallery />
  </Section>

  <Section>
    <CTABand
      layout="center"
      title="Have a project in mind?"
      subtitle="Let’s make it real."
      ctaLabel="Start a conversation"
    />
  </Section>
</BaseLayout>
