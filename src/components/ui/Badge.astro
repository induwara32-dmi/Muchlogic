---
interface Props {
  tone?: 'primary' | 'neutral' | 'outline';
  class?: string;
}

const { tone = 'primary', class: className } = Astro.props;

const tones = {
  primary: 'bg-primary-soft text-primary',
  neutral: 'bg-surface-alt text-body',
  outline: 'border border-line bg-surface text-body',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-control px-2.5 py-1 text-xs font-semibold uppercase tracking-wider',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
