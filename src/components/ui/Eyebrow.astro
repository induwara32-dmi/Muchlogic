---
interface Props {
  class?: string;
  onDark?: boolean;
}

const { class: className, onDark = false } = Astro.props;
---

<p
  class:list={[
    'text-[0.8125rem] font-semibold uppercase tracking-[0.12em]',
    onDark ? 'text-primary-on-dark' : 'text-primary',
    className,
  ]}
>
  <slot />
</p>
