---
/** Minimal window chrome (three dots) shown above product screenshots. Decorative, CSS only. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={['flex shrink-0 items-center gap-1.5 border-b border-line bg-surface px-3', className]}
>
  <span class="size-2 rounded-pill bg-ink/15"></span>
  <span class="size-2 rounded-pill bg-ink/15"></span>
  <span class="size-2 rounded-pill bg-ink/15"></span>
</div>
