---
import { Image } from 'astro:assets';
import markDark from '../../assets/brand/logo-mark.png';
import markLight from '../../assets/brand/logo-mark-white.png';
import wordmarkDark from '../../assets/brand/logo-wordmark.png';
import wordmarkLight from '../../assets/brand/logo-wordmark-white.png';
import { site } from '../../data/site';

interface Props {
  /** Use the white logo on dark backgrounds */
  inverted?: boolean;
  class?: string;
}

const { inverted = false, class: className } = Astro.props;
const mark = inverted ? markLight : markDark;
const wordmark = inverted ? wordmarkLight : wordmarkDark;
---

<a
  href="/"
  class:list={['inline-flex items-center gap-2.5 rounded-md', className]}
  aria-label={`${site.name} home`}
>
  <Image src={mark} alt="" width={120} class="h-auto w-[3.75rem] shrink-0" loading="eager" />
  <Image src={wordmark} alt="" width={256} class="h-auto w-[8rem] shrink-0" loading="eager" />
</a>
