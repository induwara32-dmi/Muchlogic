---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'ghost' | 'light' | 'on-dark';
type Size = 'md' | 'lg';

type Props = {
  href?: string;
  variant?: Variant;
  size?: Size;
  /** Full width below the sm breakpoint */
  block?: boolean;
  icon?: IconName;
  external?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class'>;

const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  icon,
  external = false,
  class: className,
  ...rest
} = Astro.props;

// Hover: 1px lift + softer, larger shadow. Pressed: back down and slightly smaller.
const lift = 'hover:-translate-y-px active:translate-y-0 active:scale-[0.98]';

const variants: Record<Variant, string> = {
  primary: `bg-primary text-white shadow-button-primary hover:bg-primary-hover hover-shadow [--hover-shadow:var(--shadow-button-primary-hover)] ${lift}`,
  secondary: `border border-ink/15 bg-surface text-ink shadow-button hover:border-ink/25 hover-shadow [--hover-shadow:var(--shadow-button-hover)] ${lift}`,
  ghost: 'text-ink hover:text-primary',
  light: `bg-white text-ink shadow-button hover-shadow [--hover-shadow:var(--shadow-button-hover)] ${lift}`,
  'on-dark': `border border-white/20 bg-white/10 text-white hover:border-white/30 hover:bg-white/15 ${lift}`,
};

const sizes: Record<Size, string> = {
  md: 'min-h-tap px-5 text-sm',
  lg: 'min-h-12 px-7 text-[0.9375rem]',
};

const classes = [
  'group inline-flex items-center justify-center gap-2 rounded-control font-medium transition-[background-color,border-color,translate,scale] duration-200 ease-(--ease-out-soft)',
  'disabled:cursor-not-allowed disabled:opacity-60',
  variants[variant],
  variant === 'ghost' ? 'px-0' : sizes[size],
  block && 'w-full sm:w-auto',
  className,
];

const Tag = href ? 'a' : 'button';
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag href={href} class:list={classes} {...externalAttrs} {...rest}>
  <slot />
  {
    icon && (
      <Icon
        name={icon}
        size={18}
        class="arrow-nudge"
      />
    )
  }
  {external && <span class="sr-only">(opens in a new tab)</span>}
</Tag>
