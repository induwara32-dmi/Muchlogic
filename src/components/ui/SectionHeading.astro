---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  /** id for the h2, so the section can use aria-labelledby */
  id?: string;
  align?: 'left' | 'center';
  description?: string;
  class?: string;
}

const { eyebrow, id, align = 'left', description, class: className } = Astro.props;
const centered = align === 'center';
---

<div class:list={[centered && 'mx-auto max-w-2xl text-center', className]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2
    id={id}
    class:list={[
      'text-[1.75rem] leading-[1.2] tracking-heading md:text-[2.125rem] lg:text-[2.375rem]',
      eyebrow && 'mt-3',
    ]}
  >
    <slot />
  </h2>
  {
    description && (
      <p class:list={['mt-4 text-[1.0625rem] text-body', centered && 'mx-auto max-w-xl']}>{description}</p>
    )
  }
</div>
