---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  /** id for the h2, so the section can use aria-labelledby */
  id?: string;
  align?: 'left' | 'center';
  description?: string;
  class?: string;
}

const { eyebrow, id, align = 'left', description, class: className } = Astro.props;
const centered = align === 'center';
---

<div class:list={[centered && 'mx-auto max-w-2xl text-center', className]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2
    id={id}
    class:list={[
      'text-[2rem] leading-[1.15] tracking-tighter md:text-[2.625rem] lg:text-5xl',
      eyebrow && 'mt-3',
    ]}
  >
    <slot />
  </h2>
  {
    description && (
      <p class:list={['mt-4 text-lg text-body', centered && 'mx-auto max-w-xl']}>{description}</p>
    )
  }
</div>
