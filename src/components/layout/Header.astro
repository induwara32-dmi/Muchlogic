---
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { navLinks, site, emailHref, locationLabel, isPlaceholder } from '../../data/site';
import { team } from '../../data/team';

// Top bar shows each co-founder's mobile number (from team.ts), skipping placeholders
const contacts = team.flatMap((member) =>
  member.phone && !isPlaceholder(member.phone.e164)
    ? [{ name: member.name.split(' ')[0], ...member.phone }]
    : [],
);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}

const links = navLinks.map((link) => ({
  ...link,
  active: isActive(link.href),
  exact: path === link.href,
}));
---

<!-- Utility bar: contact details at a glance (phone number is tap-to-call on mobile) -->
<div data-topbar class="bg-dark text-[0.8125rem] text-dark-muted">
  <!-- Phones: compact icon-only links (44px tap targets, labelled for screen readers) -->
  <Container class="flex h-[44px] items-center justify-between md:hidden">
    <span class="inline-flex items-center gap-2">
      <Icon name="map-pin" size={14} />
      {locationLabel}
    </span>
    <ul class="-mr-2.5 flex items-center">
      <li>
        <a
          href={emailHref}
          aria-label={`Email ${site.email}`}
          class="inline-flex size-[44px] items-center justify-center text-white transition-colors hover:text-primary-on-dark"
        >
          <Icon name="mail" size={18} />
        </a>
      </li>
      {
        contacts.map((contact) => (
          <li>
            <a
              href={`tel:${contact.e164}`}
              aria-label={`Call ${contact.name} on ${contact.display}`}
              class="inline-flex h-[44px] items-center gap-1.5 px-2.5 font-medium text-white transition-colors hover:text-primary-on-dark"
            >
              <Icon name="phone" size={16} />
              {contact.name}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>

  <Container class="hidden h-10 items-center justify-between md:flex">
    <p class="hidden items-center gap-2 lg:inline-flex">
      <Icon name="map-pin" size={14} />
      {locationLabel}
    </p>
    <ul class="flex w-full items-center justify-between gap-4 lg:w-auto lg:justify-end lg:gap-7">
      <li class="order-3 hidden sm:block lg:order-first">
        <a href={emailHref} class="inline-flex items-center gap-2 transition-colors hover:text-white">
          <Icon name="mail" size={14} />
          {site.email}
        </a>
      </li>
      {
        contacts.map((contact) => (
          <li>
            <a
              href={`tel:${contact.e164}`}
              class="inline-flex items-center gap-2 font-medium text-white transition-colors hover:text-primary-on-dark lg:font-normal lg:text-dark-muted lg:hover:text-white"
            >
              <Icon name="phone" size={14} />
              <span class="hidden lg:inline">{contact.name}</span>{' '}
              {contact.display}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</div>

<!--
  After scrolling: soft shadow; on desktop the bar also tucks up 8px and its content moves down 4px,
  so it reads 64px tall without resizing anything (transforms only, no layout shift).
-->
<header
  data-header
  class="header-shadow group/header sticky top-0 z-40 border-b border-line bg-surface transition-[translate] duration-300 ease-(--ease-out-soft) lg:data-scrolled:-translate-y-2"
>
  <Container class="flex h-16 items-center justify-between gap-6 transition-[translate] duration-300 ease-(--ease-out-soft) lg:h-[4.5rem] lg:group-data-scrolled/header:translate-y-1">
    <Logo />

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.exact ? 'page' : undefined}
                class:list={[
                  'group/link relative inline-flex min-h-11 items-center px-4 text-[0.9375rem] font-medium transition-colors',
                  link.active ? 'text-ink' : 'text-body hover:text-ink',
                ]}
              >
                {link.label}
                {/* Underline grows from the centre: full on the active page, previewed on hover */}
                <span
                  aria-hidden="true"
                  class:list={[
                    'absolute inset-x-4 bottom-0 h-0.5 origin-center rounded-pill transition-[scale,background-color] duration-300 ease-(--ease-out-soft)',
                    link.active
                      ? 'scale-x-100 bg-primary'
                      : 'scale-x-0 bg-ink/25 group-hover/link:scale-x-100 group-focus-visible/link:scale-x-100',
                  ]}
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden lg:block">
        <Button href="/contact">Get a quote</Button>
      </div>
      <button
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="-mr-2 inline-flex size-11 items-center justify-center rounded-md text-ink lg:hidden"
      >
        <Icon name="menu" size={24} />
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </Container>
</header>

<dialog
  id="mobile-menu"
  aria-label="Menu"
  class="m-0 h-dvh max-h-none w-full max-w-none bg-surface p-0 text-body lg:hidden"
>
  <div class="flex h-full flex-col overflow-y-auto">
    <Container class="flex h-16 shrink-0 items-center justify-between">
      <Logo />
      <button
        type="button"
        data-menu-close
        class="-mr-2 inline-flex size-11 items-center justify-center rounded-md text-ink"
      >
        <Icon name="x" size={24} />
        <span class="sr-only">Close menu</span>
      </button>
    </Container>

    <Container class="flex flex-1 flex-col justify-between gap-10 pb-10 pt-6">
      <nav aria-label="Mobile">
        <ul class="divide-y divide-line border-y border-line">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={link.exact ? 'page' : undefined}
                  class:list={[
                    'flex min-h-14 items-center justify-between py-3 text-xl font-semibold tracking-heading',
                    link.active ? 'text-primary' : 'text-ink',
                  ]}
                >
                  {link.label}
                  <Icon name="arrow-right" size={20} class="text-muted" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="space-y-6">
        <Button href="/contact" size="lg" class="w-full">Get a quote</Button>
        <ul class="space-y-2 text-base">
          <li>
            <a href={emailHref} class="inline-flex items-center gap-2 text-ink hover:text-primary">
              <Icon name="mail" size={18} class="text-primary" />
              {site.email}
            </a>
          </li>
          {
            contacts.map((contact) => (
              <li>
                <a href={`tel:${contact.e164}`} class="inline-flex items-center gap-2 text-ink hover:text-primary">
                  <Icon name="phone" size={18} class="text-primary" />
                  <span class="text-body">{contact.name}</span>{' '}
                  {contact.display}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </div>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');

  // Sticky header: shadow (and compact on desktop) once the page has scrolled.
  // Hysteresis (on at 24px, off at 4px) stops it flickering around the threshold.
  // Also set on <html> so other sticky bars (the services chip bar) can follow.
  if (header) {
    let ticking = false;
    let scrolled = false;
    const update = () => {
      const y = window.scrollY;
      const next = scrolled ? y > 4 : y > 24;
      if (next !== scrolled) {
        scrolled = next;
        header.toggleAttribute('data-scrolled', scrolled);
        document.documentElement.toggleAttribute('data-scrolled', scrolled);
      }
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  if (menu && openButton && closeButton) {
    const root = document.documentElement;

    const openMenu = () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
      root.style.overflow = 'hidden';
      closeButton.focus();
    };

    const closeMenu = () => {
      if (menu.open) menu.close();
    };

    openButton.addEventListener('click', openMenu);
    closeButton.addEventListener('click', closeMenu);

    // Fires for close(), Escape and form-method="dialog"
    menu.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false');
      root.style.overflow = '';
      openButton.focus();
    });

    // Close before navigating so the scroll lock is released
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    // Keep Tab / Shift+Tab inside the menu
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusable = Array.from(
        menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      );
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Close if the viewport grows to the desktop layout
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  }
</script>
