---
/** Technologies we use — names only (no third-party logos). List lives in services.ts. */
import { technologies } from '../../data/services';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul class:list={['grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5 lg:gap-5', className]}>
  {
    technologies.map((tech, i) => (
      <li
        data-reveal
        style={`--reveal-delay:${(i % 5) * 50}ms`}
        class="flex min-h-20 items-center justify-center rounded-card border border-line bg-surface px-4 py-5 text-center font-semibold text-ink"
      >
        {tech}
      </li>
    ))
  }
</ul>
