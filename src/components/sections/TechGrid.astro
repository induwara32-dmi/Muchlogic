---
/**
 * Technologies we use, from services.ts. Logos (simple-icons) are monochrome and take their
 * brand colour on hover/focus; technologies without a logo show the name only.
 */
import { technologies } from '../../data/services';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul class:list={['grid grid-cols-2 gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-3 md:grid-cols-5', className]}>
  {
    technologies.map((tech) => (
      <li
        data-reveal
        style={tech.icon ? `--brand:#${tech.icon.hex}` : undefined}
        class="group flex min-h-28 flex-col items-center justify-center gap-3 bg-surface px-4 py-5 text-center"
      >
        {tech.icon && (
          <svg
            viewBox="0 0 24 24"
            width="32"
            height="32"
            aria-hidden="true"
            class="size-8 fill-muted transition-colors duration-200 group-hover:fill-[var(--brand)]"
          >
            <path d={tech.icon.path} />
          </svg>
        )}
        <span class="text-[0.9375rem] font-medium text-ink">{tech.name}</span>
      </li>
    ))
  }
</ul>
