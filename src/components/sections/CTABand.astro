---
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  /** Second line, shown muted */
  subtitle?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  class?: string;
}

const {
  title,
  subtitle,
  description,
  ctaLabel = 'Start your project',
  ctaHref = '/contact',
  class: className,
} = Astro.props;
---

<div
  data-reveal
  class:list={[
    'flex flex-col gap-8 rounded-card bg-dark px-6 py-10 sm:px-10 md:flex-row md:items-center md:justify-between md:px-16 md:py-14',
    className,
  ]}
>
  <div class="max-w-2xl">
    <h2 class="text-3xl leading-tight tracking-display text-white md:text-4xl">
      {title}{' '}
      {subtitle && <span class="block text-dark-muted">{subtitle}</span>}
    </h2>
    {description && <p class="mt-4 text-lg text-dark-muted">{description}</p>}
  </div>
  <Button href={ctaHref} variant="light" size="lg" icon="arrow-right" block class="shrink-0">
    {ctaLabel}
  </Button>
</div>
