---
/**
 * Contact form → POST /api/contact.
 * - No JS: native HTML validation, normal POST, server redirects to /contact/thank-you
 *   or back to /contact#error-<code> (banners below show via :target)
 * - With JS: inline errors (aria-describedby), loading state, JSON submit, ?service= preselect
 */
import Icon from '../ui/Icon.astro';
import { services } from '../../data/services';
import { budgetOptions, NOT_SURE_SERVICE } from '../../data/contact';
import { ELAPSED_FIELD, HONEYPOT_FIELD, LIMITS } from '../../lib/contact';

interface Props {
  labelledBy?: string;
  class?: string;
}

const { labelledBy, class: className } = Astro.props;

const serviceOptions = [...services.map((s) => ({ value: s.slug, label: s.title })), {
  value: NOT_SURE_SERVICE.slug,
  label: NOT_SURE_SERVICE.title,
}];

const label = 'block text-sm font-semibold text-ink';
const control =
  'mt-2 block w-full rounded-control border border-ink/25 bg-surface px-4 py-3 text-base text-ink placeholder:text-muted transition-colors hover:border-ink/50 focus:border-primary focus:outline-none focus-visible:outline-none aria-[invalid=true]:border-danger aria-[invalid=true]:bg-danger-soft';
const errorText = 'mt-1.5 flex items-start gap-1.5 text-sm font-medium text-danger empty:hidden';

// Server-side errors for no-JS submissions (shown with :target)
const serverErrors = [
  { id: 'error-invalid', text: 'Some details need fixing. Please check the form and send it again.' },
  { id: 'error-too-fast', text: 'That was quick! Please wait a moment and send the form again.' },
  { id: 'error-send', text: 'Sorry, we couldn’t send your message. Please try again, or email us directly.' },
];
---

<form
  data-contact-form
  method="post"
  action="/api/contact"
  aria-labelledby={labelledBy}
  class:list={['rounded-card border border-line bg-surface p-5 shadow-card sm:p-8 lg:p-10', className]}
>
  {
    serverErrors.map((error) => (
      <div
        id={error.id}
        role="alert"
        tabindex="-1"
        class="mb-6 hidden items-start gap-3 rounded-control border border-danger/30 bg-danger-soft p-4 text-danger target:flex"
      >
        <Icon name="alert-circle" size={20} class="mt-0.5" />
        <p class="font-medium">{error.text}</p>
      </div>
    ))
  }
  <div
    data-form-status
    role="alert"
    tabindex="-1"
    class="mb-6 hidden items-start gap-3 rounded-control border border-danger/30 bg-danger-soft p-4 text-danger"
  >
    <Icon name="alert-circle" size={20} class="mt-0.5" />
    <p data-form-status-text class="font-medium"></p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="cf-name" class={label}>Full name</label>
      <input
        id="cf-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        minlength={LIMITS.name.min}
        maxlength={LIMITS.name.max}
        placeholder="Your full name"
        aria-describedby="cf-name-error"
        data-error-required="Please enter your full name."
        data-error-short="Please enter your full name."
        class={control}
      />
      <p id="cf-name-error" class={errorText} data-error-for="name"></p>
    </div>

    <div>
      <label for="cf-email" class={label}>Email</label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="200"
        placeholder="you@company.com"
        aria-describedby="cf-email-error"
        data-error-required="Please enter your email address."
        data-error-invalid="Please enter a valid email address."
        class={control}
      />
      <p id="cf-email-error" class={errorText} data-error-for="email"></p>
    </div>

    <div>
      <label for="cf-phone" class={label}>Phone</label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        required
        pattern="\+?[0-9][0-9\s\-\(\)]{6,19}"
        placeholder="+94 7X XXX XXXX"
        aria-describedby="cf-phone-error"
        data-error-required="Please enter your phone number."
        data-error-invalid="Please enter a valid phone number, e.g. +94 7X XXX XXXX."
        class={control}
      />
      <p id="cf-phone-error" class={errorText} data-error-for="phone"></p>
    </div>

    <div>
      <label for="cf-company" class={label}>Company <span class="font-normal text-body">(optional)</span></label>
      <input
        id="cf-company"
        name="company"
        type="text"
        autocomplete="organization"
        maxlength={LIMITS.company.max}
        placeholder="Company name"
        aria-describedby="cf-company-error"
        class={control}
      />
      <p id="cf-company-error" class={errorText} data-error-for="company"></p>
    </div>

    <div class="sm:col-span-2">
      <label for="cf-website" class={label}>Website <span class="font-normal text-body">(optional)</span></label>
      <input
        id="cf-website"
        name="website"
        type="text"
        inputmode="url"
        autocomplete="url"
        maxlength={LIMITS.website.max}
        pattern="(https?://)?[^\s/]+\.[^\s]+"
        placeholder="example.com"
        aria-describedby="cf-website-error"
        data-error-invalid="Please enter a valid website, e.g. example.com."
        class={control}
      />
      <p id="cf-website-error" class={errorText} data-error-for="website"></p>
    </div>

    <div class="sm:col-span-2">
      <label for="cf-service" class={label}>What service are you looking for?</label>
      <div class="relative">
        <select
          id="cf-service"
          name="service"
          required
          aria-describedby="cf-service-error"
          data-error-required="Please choose a service."
          class:list={[control, 'appearance-none pr-12']}
        >
          <option value="" disabled selected>Choose a service</option>
          {serviceOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <Icon
          name="chevron-down"
          size={20}
          class="pointer-events-none absolute right-4 top-1/2 mt-1 -translate-y-1/2 text-body"
        />
      </div>
      <p id="cf-service-error" class={errorText} data-error-for="service"></p>
    </div>

    <fieldset class="sm:col-span-2" aria-describedby="cf-budget-error">
      <legend class={label}>Estimated budget</legend>
      <div class="mt-3 flex flex-wrap gap-2.5">
        {
          budgetOptions.map((option, i) => (
            <label class="relative inline-flex min-h-11 cursor-pointer items-center rounded-control border border-ink/15 bg-surface px-4 text-sm font-medium text-ink shadow-button transition-colors hover:bg-surface-alt has-checked:border-primary has-checked:bg-primary has-checked:text-white has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary has-[[aria-invalid=true]]:border-danger">
              <input
                type="radio"
                name="budget"
                value={option.value}
                required
                class="sr-only"
                data-error-required={i === 0 ? 'Please choose a budget range.' : undefined}
              />
              {option.label}
            </label>
          ))
        }
      </div>
      <p id="cf-budget-error" class={errorText} data-error-for="budget"></p>
    </fieldset>

    <div class="sm:col-span-2">
      <label for="cf-details" class={label}>Project details</label>
      <textarea
        id="cf-details"
        name="details"
        rows="5"
        required
        minlength={LIMITS.details.min}
        maxlength={LIMITS.details.max}
        placeholder="What would you like to build? Who is it for, and what problem should it solve?"
        aria-describedby="cf-details-error"
        data-error-required="Please tell us about your project."
        data-error-short="Please tell us a little more about your project (at least 10 characters)."
        class:list={[control, 'min-h-36 resize-y']}
      ></textarea>
      <p id="cf-details-error" class={errorText} data-error-for="details"></p>
    </div>

    <div class="sm:col-span-2">
      <div class="flex items-start gap-3">
        <input
          id="cf-consent"
          name="consent"
          type="checkbox"
          required
          aria-describedby="cf-consent-error"
          data-error-required="Please accept the privacy policy so we can reply."
          class="mt-1 size-5 shrink-0 cursor-pointer rounded accent-primary aria-[invalid=true]:outline-2 aria-[invalid=true]:outline-danger"
        />
        <label for="cf-consent" class="text-sm text-body">
          I agree that MuchLogic may use these details to reply to my inquiry, as described in the{' '}
          <a href="/privacy" target="_blank" class="font-semibold text-primary underline underline-offset-2 hover:text-primary-hover">
            privacy policy<span class="sr-only"> (opens in a new tab)</span></a>.
        </label>
      </div>
      <p id="cf-consent-error" class={errorText} data-error-for="consent"></p>
    </div>
  </div>

  <!-- Spam protection: honeypot (hidden from people) + time since page load -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label for="cf-hp">Leave this field empty</label>
    <input id="cf-hp" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name={ELAPSED_FIELD} value="" data-elapsed disabled />

  <button
    type="submit"
    data-submit
    class="group mt-8 inline-flex min-h-13 w-full items-center justify-center gap-2.5 rounded-control bg-primary px-6 text-base font-medium text-white shadow-button-primary transition-[background-color,transform] duration-150 hover:bg-primary-hover active:scale-[0.99] disabled:cursor-wait disabled:opacity-80"
  >
    <svg
      data-spinner
      class="hidden size-5 animate-spin"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity=".3" stroke-width="3"></circle>
      <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
    </svg>
    <span data-submit-label>Send inquiry</span>
    <Icon name="send" size={18} class="group-disabled:hidden" />
  </button>
</form>

<script>
  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const startedAt = performance.now();
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const spinner = form.querySelector<SVGElement>('[data-spinner]')!;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const statusText = form.querySelector<HTMLElement>('[data-form-status-text]')!;
    const elapsedInput = form.querySelector<HTMLInputElement>('[data-elapsed]')!;
    const names = ['name', 'email', 'phone', 'company', 'website', 'service', 'budget', 'details', 'consent'];
    const touched = new Set<string>();

    // JS takes over validation messages; HTML constraints still drive the checks
    form.noValidate = true;
    elapsedInput.disabled = false;

    // Preselect the service from ?service=<slug> (e.g. "Discuss this service" links)
    const requested = new URLSearchParams(window.location.search).get('service');
    const select = form.elements.namedItem('service') as HTMLSelectElement;
    if (requested && Array.from(select.options).some((o) => o.value === requested)) {
      select.value = requested;
    }

    const fieldsFor = (name: string): Field[] =>
      Array.from(form.querySelectorAll<Field>(`[name="${name}"]`));

    const messageFor = (name: string): string => {
      const fields = fieldsFor(name);
      const field = fields[0];
      if (!field) return '';
      const v = field.validity;
      const data = (fields.find((f) => f.dataset.errorRequired) ?? field).dataset;
      if (v.valueMissing) return data.errorRequired ?? 'This field is required.';
      if (v.tooShort) return data.errorShort ?? data.errorRequired ?? 'Please enter a little more.';
      if (v.typeMismatch || v.patternMismatch) return data.errorInvalid ?? 'Please check this field.';
      if (v.tooLong) return 'This is a bit too long.';
      return '';
    };

    const showError = (name: string, message: string) => {
      const target = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (target) target.textContent = message;
      for (const field of fieldsFor(name)) {
        if (message) field.setAttribute('aria-invalid', 'true');
        else field.removeAttribute('aria-invalid');
      }
    };

    const validate = (name: string) => {
      const message = messageFor(name);
      showError(name, message);
      return message === '';
    };

    // Validate a field when the user leaves it, then live once it has been touched
    for (const name of names) {
      for (const field of fieldsFor(name)) {
        field.addEventListener('blur', () => {
          if ((field as HTMLInputElement).value || touched.has(name)) {
            touched.add(name);
            validate(name);
          }
        });
        field.addEventListener(field.type === 'radio' || field.type === 'checkbox' || field.tagName === 'SELECT' ? 'change' : 'input', () => {
          if (touched.has(name)) validate(name);
        });
      }
    }

    const setLoading = (loading: boolean) => {
      submit.disabled = loading;
      submit.setAttribute('aria-busy', String(loading));
      spinner.classList.toggle('hidden', !loading);
      submitLabel.textContent = loading ? 'Sending…' : 'Send inquiry';
    };

    const showStatus = (message: string) => {
      statusText.textContent = message;
      status.classList.remove('hidden');
      status.classList.add('flex');
      status.focus();
    };

    const hideStatus = () => {
      status.classList.add('hidden');
      status.classList.remove('flex');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      hideStatus();

      names.forEach((name) => touched.add(name));
      const invalid = names.filter((name) => !validate(name));
      if (invalid.length > 0) {
        fieldsFor(invalid[0]!)[0]?.focus();
        return;
      }

      elapsedInput.value = String(Math.round(performance.now() - startedAt));
      setLoading(true);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          message?: string;
          errors?: Record<string, string>;
        };

        if (response.ok && result.ok) {
          window.location.assign('/contact/thank-you');
          return;
        }

        if (result.errors) {
          for (const [name, message] of Object.entries(result.errors)) showError(name, message);
        }
        showStatus(result.message ?? 'Sorry, we couldn’t send your message. Please try again.');
      } catch {
        showStatus('We couldn’t reach the server. Please check your connection and try again.');
      } finally {
        setLoading(false);
      }
    });
  }
</script>
