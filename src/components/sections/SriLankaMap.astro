---
/**
 * Decorative outline of Sri Lanka with a location pin.
 * Outline path lives in sriLankaOutline.ts (shared with the Contact location card).
 */
import { locationLabel } from '../../data/site';
import { sriLankaOutline as outline } from './sriLankaOutline';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;


// Pin near the centre of the island (city not confirmed yet)
const pin = { x: 125, y: 245 };
---

<figure
  class:list={[
    'relative flex items-center justify-center overflow-hidden rounded-card border border-line bg-surface-alt px-6 pb-20 pt-10',
    className,
  ]}
>
  <svg
    viewBox="0 0 249 419"
    class="h-72 w-auto text-primary sm:h-80 lg:h-96"
    aria-hidden="true"
    fill="none"
  >
    <path d={outline} class="fill-primary-soft" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
    <circle cx={pin.x} cy={pin.y} r="18" class="fill-primary/15" />
    <path
      d={`M${pin.x} ${pin.y + 6}c-6-7-11-12-11-18a11 11 0 1 1 22 0c0 6-5 11-11 18z`}
      fill="currentColor"
    />
    <circle cx={pin.x} cy={pin.y - 12} r="4" class="fill-white" />
  </svg>
  <figcaption
    class="absolute bottom-6 left-1/2 -translate-x-1/2 rounded-control border border-line bg-surface px-4 py-1.5 text-[0.8125rem] font-semibold uppercase tracking-[0.12em] text-ink"
  >
    {locationLabel}
  </figcaption>
</figure>
