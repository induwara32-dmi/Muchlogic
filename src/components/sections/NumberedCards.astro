---
import type { Feature } from '../../data/home';

interface Props {
  items: Feature[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ol class:list={['divide-y divide-line border-y border-line', className]}>
  {
    items.map((item, i) => (
      <li data-reveal class="grid gap-x-8 gap-y-2 py-7 sm:grid-cols-[3.5rem_minmax(0,1fr)]">
        <span class="inline-flex size-9 items-center justify-center rounded-xl bg-primary-soft text-sm font-semibold tabular-nums text-primary" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div>
          <h3 class="text-lg">{item.title}</h3>
          <p class="mt-1.5">{item.description}</p>
        </div>
      </li>
    ))
  }
</ol>
