---
/**
 * Featured projects slider (native CSS scroll-snap, no library).
 * - < 768px: swipe slider, one card ~85% wide with the next one peeking
 * - 768–1023px: slider with ~1.6 cards, prev/next arrows
 * - ≥ 1024px: 3-column grid when there are ≤ 3 projects; otherwise a slider with 3 visible
 * Without JS it's still a scrollable row; arrows and dots appear only once JS runs.
 */
import Icon from '../ui/Icon.astro';
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../../data/projects';

interface Props {
  projects: Project[];
  label?: string;
  class?: string;
}

const { projects, label = 'Recent projects', class: className } = Astro.props;
// Desktop only becomes a slider when the cards don't fit in one row of three
const desktopSlider = projects.length > 3;

const arrow =
  'inline-flex size-tap items-center justify-center rounded-pill border border-ink/15 bg-surface text-ink shadow-button transition-[background-color,opacity] hover:bg-surface-alt disabled:cursor-default disabled:opacity-40 disabled:hover:bg-surface';
---

<div
  data-slider
  data-reveal
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  class={className}
>
  <!--
    The track bleeds to the screen edge on mobile/tablet (negative margin + matching padding and
    scroll-padding) so cards snap in line with the page content. Vertical padding leaves room for
    card hover lift and shadows, which overflow-x would otherwise clip.
  -->
  <ul
    data-track
    class:list={[
      'relative -mx-4 -my-3 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto overscroll-x-contain px-4 py-3 pb-8',
      'scroll-smooth motion-reduce:scroll-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
      'sm:-mx-6 sm:scroll-px-6 sm:px-6 md:gap-6',
      desktopSlider
        ? 'lg:-mx-8 lg:scroll-px-8 lg:px-8'
        : 'lg:mx-0 lg:grid lg:grid-cols-3 lg:overflow-visible lg:px-0',
    ]}
  >
    {
      projects.map((project, i) => (
        <li
          data-slide
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${projects.length}`}
          class:list={[
            'w-[85%] shrink-0 snap-start md:w-[calc((100%-1.5rem)/1.6)]',
            desktopSlider ? 'lg:w-[calc((100%-3rem)/3)]' : 'lg:w-auto',
          ]}
        >
          <ProjectCard project={project} />
        </li>
      ))
    }
  </ul>

  <!-- Controls: only with JS (js: variant), and on desktop only when it's a slider -->
  <div
    class:list={[
      'mt-2 hidden items-center justify-between gap-4 js:flex',
      !desktopSlider && 'lg:js:hidden',
    ]}
  >
    <div class="flex items-center gap-1" data-dots>
      {
        projects.map((_, i) => (
          <button
            type="button"
            data-dot={i}
            aria-label={`Go to project ${i + 1} of ${projects.length}`}
            aria-current={i === 0 ? 'true' : undefined}
            class="group/dot inline-flex size-tap items-center justify-center"
          >
            <span class="block h-2 w-2 rounded-pill bg-ink/20 transition-[width,background-color] duration-300 group-aria-[current=true]/dot:w-6 group-aria-[current=true]/dot:bg-primary" />
          </button>
        ))
      }
    </div>
    <div class="hidden gap-3 md:flex">
      <button type="button" data-prev aria-label="Previous project" class={arrow} disabled>
        <Icon name="arrow-left" size={20} />
      </button>
      <button type="button" data-next aria-label="Next project" class={arrow}>
        <Icon name="arrow-right" size={20} />
      </button>
    </div>
  </div>
</div>

<script>
  for (const slider of document.querySelectorAll<HTMLElement>('[data-slider]')) {
    const track = slider.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prev = slider.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = slider.querySelector<HTMLButtonElement>('[data-next]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const behavior = (): ScrollBehavior => (reduce.matches ? 'auto' : 'smooth');

    // Scroll so slide i sits at the snap edge (track's left padding)
    const goTo = (i: number) => {
      const slide = slides[Math.max(0, Math.min(i, slides.length - 1))];
      if (!slide) return;
      const pad = parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
      track.scrollTo({ left: slide.offsetLeft - pad, behavior: behavior() });
    };

    // Current = first slide that is mostly visible inside the track
    const ratios = new Map<Element, number>();
    let current = 0;
    const setCurrent = (i: number) => {
      current = i;
      dots.forEach((dot, d) => (d === i ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current')));
    };
    const atEnd = () => track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
    const updateCurrent = () => {
      // At the far end the last slide can't reach the snap edge, so mark it explicitly
      if (atEnd() && track.scrollWidth > track.clientWidth + 1) return setCurrent(slides.length - 1);
      const first = slides.findIndex((s) => (ratios.get(s) ?? 0) >= 0.6);
      if (first >= 0) setCurrent(first);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) ratios.set(e.target, e.intersectionRatio);
        updateCurrent();
      },
      { root: track, threshold: [0, 0.6, 1] },
    );
    slides.forEach((s) => observer.observe(s));

    // Arrows: disabled at the ends
    const updateArrows = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };
    let frame = 0;
    track.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(() => { frame = 0; updateArrows(); updateCurrent(); });
    }, { passive: true });
    window.addEventListener('resize', updateArrows, { passive: true });
    updateArrows();

    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Keyboard: bring a card into view when something inside it gets focus
    track.addEventListener('focusin', (event) => {
      const slide = (event.target as HTMLElement).closest<HTMLElement>('[data-slide]');
      if (!slide) return;
      const t = track.getBoundingClientRect();
      const s = slide.getBoundingClientRect();
      if (s.left < t.left || s.right > t.right) goTo(slides.indexOf(slide));
    });
  }
</script>
