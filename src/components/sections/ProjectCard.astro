---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import Badge from '../ui/Badge.astro';
import { caseNumber, publicDetails, type Project } from '../../data/projects';
import { getProjectImage } from '../../lib/images';

interface Props {
  project: Project;
  /**
   * 'card' = bordered card with category badge (Home)
   * 'plain' = borderless, "Case 01 · Category" label and tech pills (Our Work)
   */
  variant?: 'card' | 'plain';
  headingLevel?: 'h2' | 'h3';
  /** Eager-load when the card is above the fold */
  priority?: boolean;
}

const { project, variant = 'card', headingLevel: Heading = 'h3', priority = false } = Astro.props;
const image = getProjectImage(project.image);
const { tech } = publicDetails(project);
const plain = variant === 'plain';

// Screenshots: keep the top (site nav + headline) in view when cropped
const positions = {
  top: 'object-top',
  'left top': 'object-top-left',
  'right top': 'object-top-right',
} as const;
const imagePosition = image.isPlaceholder ? undefined : positions[project.imagePosition ?? 'top'];
---

<article
  class:list={[
    'group relative flex h-full flex-col',
    plain
      ? ''
      : 'overflow-hidden rounded-card border border-line bg-surface shadow-card transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_18px_40px_-16px_rgb(11_27_46/0.25)]',
  ]}
>
  <div
    class:list={[
      'relative aspect-[16/10] overflow-hidden bg-surface-alt',
      plain
        ? 'rounded-card border border-line'
        : 'border-b border-line',
    ]}
  >
    <Image
      src={image.src}
      alt={image.isPlaceholder ? '' : project.imageAlt}
      width={800}
      height={500}
      {...!image.isPlaceholder && {
        widths: [400, 800, 1200],
        sizes: '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw',
        // Astro crops the file itself to 16:10 — crop from the same spot the CSS shows
        position: project.imagePosition ?? 'top',
      }}
      loading={priority ? 'eager' : 'lazy'}
      class:list={['size-full object-cover', imagePosition]}
    />
    {plain && project.prototype && <Badge tone="outline" class="absolute left-4 top-4 z-10">Prototype</Badge>}
  </div>

  <div class:list={['flex flex-1 flex-col', plain ? 'pt-6' : 'p-6 sm:p-7']}>
    {
      plain ? (
        <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs font-semibold uppercase tracking-[0.12em]">
          <span class="text-primary">Case {caseNumber(project)}</span>{' '}
          <span class="size-1 rounded-pill bg-line" aria-hidden="true" />{' '}
          <span class="text-body">{project.category}</span>
        </p>
      ) : (
        <p class="flex flex-wrap items-center gap-x-2.5 text-xs font-semibold uppercase tracking-[0.12em]">
          <span class="text-primary">{project.category}</span>
          {project.prototype && <span class="text-muted">Prototype</span>}
        </p>
      )
    }
    <Heading class:list={['text-lg', plain ? 'mt-3' : 'mt-3']}>{project.title}</Heading>
    <p class="mt-2 flex-1">{project.summary}</p>

    {
      plain && tech.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tech stack">
          {tech.map((t) => (
            <li class="rounded-control border border-line bg-surface px-2.5 py-1 text-sm text-body">{t}</li>
          ))}
        </ul>
      )
    }

    <a
      href={`/work/${project.slug}`}
      class:list={[
        "mt-6 inline-flex items-center gap-1.5 self-start font-semibold after:absolute after:inset-0 after:rounded-card after:content-['']",
        'text-primary hover:text-primary-hover',
      ]}
    >
      <span class="link-label">View project</span><span class="sr-only">: {project.title}</span>
      <Icon
        name={plain ? 'chevron-right' : 'arrow-right'}
        size={18}
        class="arrow-nudge"
      />
    </a>
  </div>
</article>
