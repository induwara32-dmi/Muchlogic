---
/** Accessible FAQ accordion (<details>/<summary>) from faqs.ts. Works without JS. */
import { faqs, type Faq } from '../../data/faqs';

interface Props {
  items?: Faq[];
  class?: string;
}

const { items = faqs, class: className } = Astro.props;
---

<div class:list={['space-y-4', className]}>
  {
    items.map((faq, i) => (
      <details
        name="faq"
        open={i === 0}
        class="group rounded-card border border-line bg-surface transition-colors open:bg-surface-alt"
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-card px-6 py-5 text-lg font-semibold text-ink sm:px-8 sm:py-6 [&::-webkit-details-marker]:hidden">
          <span>{faq.question}</span>
          <span
            aria-hidden="true"
            class="relative size-5 shrink-0 text-primary before:absolute before:left-0 before:top-1/2 before:h-0.5 before:w-5 before:-translate-y-1/2 before:rounded-pill before:bg-current before:content-[''] after:absolute after:left-1/2 after:top-0 after:h-5 after:w-0.5 after:-translate-x-1/2 after:rounded-pill after:bg-current after:transition-transform after:duration-200 after:content-[''] group-open:after:scale-y-0"
          />
        </summary>
        <div class="px-6 pb-6 sm:px-8">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))
  }
</div>
