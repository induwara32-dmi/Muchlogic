---
/**
 * Client testimonials slider (Home). Renders nothing until a testimonial is approved.
 * - Visible cards: 1 (with a peek) on phones, 2 on tablets, 3 on desktop; scroll-snap, no library
 * - When there are more cards than fit: autoplay every 6 s with a 600 ms glide, seamless loop
 *   (copies of the first cards are appended; we jump back to the real ones invisibly)
 * - When everything fits: a static row with no autoplay and no controls
 * - WCAG 2.2.2: visible pause/play; pauses on hover, focus, touch, off-screen and hidden tab;
 *   no autoplay under prefers-reduced-motion. Without JS: a plain swipeable row.
 */
import Section, { type SectionTone } from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { approvedTestimonials as items, type Testimonial } from '../../data/testimonials';

interface Props {
  tone?: SectionTone;
}

const { tone = 'white' } = Astro.props;

const initials = (name: string) =>
  name.split(/\s+/).filter((p) => p.length > 1).slice(0, 2).map((p) => p[0]?.toUpperCase()).join('');

// Copies for the seamless loop: as many as can be visible at once (max 3)
const clones: Testimonial[] = items.slice(0, Math.min(3, items.length));
const slides = [...items.map((t) => ({ t, clone: false })), ...clones.map((t) => ({ t, clone: true }))];

const control =
  'inline-flex size-tap items-center justify-center rounded-pill border border-ink/15 bg-surface text-ink shadow-button transition-colors hover:bg-surface-alt';
---

{
  items.length > 0 && (
    <Section tone={tone} aria-labelledby="testimonials-title">
      <SectionHeading id="testimonials-title" eyebrow="Testimonials" class="max-w-2xl">
        What our <span class="text-primary">clients</span> say
      </SectionHeading>

      <div
        data-quotes
        data-reveal
        role="region"
        aria-roledescription="carousel"
        aria-label="Client testimonials"
        class="mt-8 md:mt-10 lg:mt-12"
      >
        <ul
          data-track
          class="relative -mx-4 -my-3 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto overscroll-x-contain px-4 py-3 pb-8 [scrollbar-width:none] sm:-mx-6 sm:scroll-px-6 sm:px-6 md:gap-6 lg:mx-0 lg:scroll-px-0 lg:px-0 [&::-webkit-scrollbar]:hidden"
        >
          {slides.map(({ t, clone }, i) => (
            <li
              data-slide={clone ? undefined : i}
              data-clone={clone ? '' : undefined}
              aria-hidden={clone ? 'true' : undefined}
              inert={clone}
              aria-roledescription={clone ? undefined : 'slide'}
              aria-label={clone ? undefined : `${i + 1} of ${items.length}`}
              class:list={[
                'w-[88%] shrink-0 snap-start md:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]',
                // Copies only exist while looping (JS sets data-loop on the track)
                clone && 'hidden in-data-loop:block',
              ]}
            >
              <figure class="flex h-full flex-col rounded-card border border-line bg-surface p-6 shadow-card sm:p-7">
                <svg viewBox="0 0 48 36" width="44" height="33" aria-hidden="true" class="shrink-0 fill-primary-soft">
                  <path d="M0 36V22.5C0 9.6 6.4 2.1 19.2 0l1.9 4.6C14 6.6 10.4 10.6 10 17h9.6v19H0zm26.9 0V22.5C26.9 9.6 33.3 2.1 46.1 0L48 4.6c-7.1 2-10.7 6-11.1 12.4h9.6v19H26.9z" />
                </svg>
                <blockquote class="mt-4 flex-1 text-[1.0625rem] leading-relaxed text-ink">
                  <p>{t.quote}</p>
                </blockquote>
                <figcaption class="mt-6 flex items-center gap-3.5 border-t border-line pt-5">
                  <span
                    aria-hidden="true"
                    class="inline-flex size-12 shrink-0 items-center justify-center rounded-card bg-primary-soft font-bold tracking-display text-primary"
                  >
                    {initials(t.name)}
                  </span>{' '}
                  <span class="min-w-0">
                    <span class="block font-semibold text-ink">{t.name}</span>{' '}
                    <span class="block text-sm">
                      {t.role},{' '}
                      {t.projectHref ? (
                        <a href={t.projectHref} class="font-medium text-primary underline-offset-2 hover:text-primary-hover hover:underline">
                          {t.company}
                        </a>
                      ) : (
                        t.company
                      )}
                    </span>
                  </span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>

        <!-- Controls: shown by JS only when the cards don't all fit -->
        <div data-controls hidden class="mt-2 flex items-center justify-between gap-4">
          <div class="flex items-center gap-1">
            <div class="flex items-center" data-dots>
              {items.map((_, i) => (
                <button
                  type="button"
                  data-dot={i}
                  aria-label={`Go to testimonial ${i + 1} of ${items.length}`}
                  aria-current={i === 0 ? 'true' : undefined}
                  class="group/dot inline-flex size-tap items-center justify-center"
                >
                  <span class="block h-2 w-2 rounded-pill bg-ink/20 transition-[width,background-color] duration-300 group-aria-[current=true]/dot:w-6 group-aria-[current=true]/dot:bg-primary" />
                </button>
              ))}
            </div>
            <button type="button" data-toggle aria-label="Pause testimonials" class:list={[control, 'ml-1 size-9 min-h-0 border-transparent shadow-none']}>
              <span data-icon-pause class="inline-flex">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="fill-current">
                  <rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" />
                </svg>
              </span>
              <span data-icon-play hidden class="inline-flex">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="fill-current">
                  <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" />
                </svg>
              </span>
            </button>
          </div>
          <div class="hidden gap-3 md:flex">
            <button type="button" data-prev aria-label="Previous testimonial" class={control}>
              <Icon name="arrow-left" size={20} />
            </button>
            <button type="button" data-next aria-label="Next testimonial" class={control}>
              <Icon name="arrow-right" size={20} />
            </button>
          </div>
        </div>
      </div>
    </Section>
  )
}

<script>
  const INTERVAL = 6000;
  const GLIDE = 600;

  for (const root of document.querySelectorAll<HTMLElement>('[data-quotes]')) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const real = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const iconPause = toggle.querySelector<HTMLElement>('[data-icon-pause]')!;
    const iconPlay = toggle.querySelector<HTMLElement>('[data-icon-play]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const n = real.length;

    let looping = false;
    let index = 0; // may reach n (a copy of slide 0) mid-loop
    let userPaused = false; // set by the Pause button only
    const holds = new Set<string>(); // temporary pauses: hover, focus, touch, offscreen, hidden
    let timer = 0;
    let anim = 0;

    // Distance between two neighbouring slides (card width + gap)
    const step = () => {
      const a = real[0]!.getBoundingClientRect();
      const b = (real[1] ?? track.querySelector('[data-clone]'))?.getBoundingClientRect();
      return b ? b.left - a.left : a.width;
    };
    const visibleCount = () => Math.max(1, Math.round(track.clientWidth / step()));

    const setDots = () => {
      const active = ((index % n) + n) % n;
      dots.forEach((d, i) => (i === active ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };

    const jumpTo = (i: number) => {
      track.scrollLeft = i * step();
    };

    // 600 ms eased glide (native smooth scroll can't be timed); snap is off while gliding
    const glideTo = (i: number, done?: () => void) => {
      cancelAnimationFrame(anim);
      const from = track.scrollLeft;
      const to = i * step();
      if (reduce.matches || Math.abs(to - from) < 1) {
        track.scrollLeft = to;
        done?.();
        return;
      }
      track.style.scrollSnapType = 'none';
      const start = performance.now();
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const frame = (now: number) => {
        const t = Math.min(1, (now - start) / GLIDE);
        track.scrollLeft = from + (to - from) * ease(t);
        if (t < 1) anim = requestAnimationFrame(frame);
        else {
          track.style.scrollSnapType = '';
          done?.();
        }
      };
      anim = requestAnimationFrame(frame);
    };

    const go = (i: number) => {
      if (!looping) return;
      if (i < 0) {
        // Before the first card: jump invisibly to the copy of slide 0, then glide back one
        jumpTo(n);
        i = n - 1;
      }
      index = i;
      setDots();
      glideTo(i, () => {
        if (index >= n) {
          index -= n;
          jumpTo(index); // the copy and the real card look identical, so this is invisible
        }
      });
      restart();
    };

    // --- Autoplay -----------------------------------------------------------------------
    const canPlay = () => looping && !reduce.matches && !userPaused && holds.size === 0;
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    const restart = () => {
      stop();
      if (canPlay()) timer = window.setInterval(() => go(index + 1), INTERVAL);
    };
    const hold = (reason: string, on: boolean) => {
      if (on) holds.add(reason);
      else holds.delete(reason);
      restart();
    };

    const renderToggle = () => {
      const paused = userPaused || reduce.matches;
      toggle.setAttribute('aria-label', paused ? 'Play testimonials' : 'Pause testimonials');
      iconPause.toggleAttribute('hidden', paused);
      iconPlay.toggleAttribute('hidden', !paused);
    };

    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      renderToggle();
      restart();
    });

    root.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && hold('hover', true));
    root.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && hold('hover', false));
    // Keyboard focus only: a mouse click on Play/Next must not leave autoplay held
    root.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).matches(':focus-visible')) hold('focus', true);
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) hold('focus', false);
    });
    // Touch: pause while the finger is down, resume a little after it lifts
    let touchTimer = 0;
    track.addEventListener('touchstart', () => { clearTimeout(touchTimer); hold('touch', true); }, { passive: true });
    track.addEventListener('touchend', () => { touchTimer = window.setTimeout(() => hold('touch', false), INTERVAL); }, { passive: true });
    document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
    new IntersectionObserver(([entry]) => hold('offscreen', !entry!.isIntersecting), { threshold: 0.25 }).observe(root);
    reduce.addEventListener('change', () => { renderToggle(); restart(); });

    // --- Manual scrolling (swipe / trackpad) ---------------------------------------------
    let settle = 0;
    track.addEventListener('scroll', () => {
      if (anim && track.style.scrollSnapType === 'none') return; // our own glide
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        const s = step();
        index = Math.round(track.scrollLeft / s);
        if (looping && index >= n) {
          index -= n;
          jumpTo(index);
        }
        setDots();
        restart();
      }, 120);
    }, { passive: true });

    root.querySelector('[data-prev]')!.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

    // --- Loop on/off depending on how many cards fit ---------------------------------------
    const layout = () => {
      const fits = n <= visibleCount();
      if (looping !== !fits) {
        looping = !fits;
        track.toggleAttribute('data-loop', looping);
        controls.hidden = !looping;
      }
      toggle.hidden = reduce.matches; // no autoplay at all under reduced motion
      index = looping ? ((index % n) + n) % n : 0;
      jumpTo(index); // re-align to the current card at the new card width
      setDots();
      renderToggle();
      restart();
    };
    // Only real width changes re-lay out: mobile browsers fire resize when the address bar
    // shows/hides during vertical scrolling, which must not move the slider.
    let lastWidth = track.clientWidth;
    let resizeTimer = 0;
    new ResizeObserver(() => {
      if (Math.abs(track.clientWidth - lastWidth) < 1) return;
      lastWidth = track.clientWidth;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(layout, 150);
    }).observe(track);
    layout();
  }
</script>
