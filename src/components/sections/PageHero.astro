---
/**
 * Hero for inner pages (Services, Work, About, Contact): left-aligned on a light band.
 * Put the title in the default slot.
 */
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import PageHeroVisual from './PageHeroVisual.astro';

interface Props {
  eyebrow?: string;
  description?: string;
  align?: 'center' | 'left';
  /** Topical illustration on the right at lg+ (left-aligned heroes only) */
  visual?: 'services' | 'work' | 'about' | 'contact';
}

const { eyebrow, description, align = 'left', visual } = Astro.props;
const centered = align === 'center';
const withVisual = visual && !centered;
---

<section class="soft-bg border-b border-line py-14 md:py-20" aria-labelledby="page-title">
  <Container
    class:list={[centered && 'text-center', withVisual && 'relative']}
  >
    <div>
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h1
        id="page-title"
        class:list={[
          'text-title font-extrabold',
          eyebrow && 'mt-4',
          centered ? 'mx-auto max-w-4xl' : 'max-w-5xl',
          // Leave room for the illustration without changing how the headline wraps
          withVisual && 'xl:max-w-[54rem]',
        ]}
      >
        <slot />
      </h1>
      {
        description && (
          <p class:list={['mt-5 max-w-2xl text-lead', centered && 'mx-auto']}>{description}</p>
        )
      }
      <slot name="after" />
    </div>
    {withVisual && <PageHeroVisual kind={visual!} />}
  </Container>
</section>
