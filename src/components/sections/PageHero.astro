---
/**
 * Hero for inner pages (Services, Work, About, Contact): left-aligned on a light band.
 * Put the title in the default slot.
 */
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  description?: string;
  align?: 'center' | 'left';
}

const { eyebrow, description, align = 'left' } = Astro.props;
const centered = align === 'center';
---

<section class="soft-bg border-b border-line py-12 md:py-20" aria-labelledby="page-title">
  <Container class={centered ? 'text-center' : undefined}>
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <h1
      id="page-title"
      class:list={[
        'text-[2.5rem] font-extrabold leading-[1.05] tracking-display sm:text-6xl lg:text-7xl',
        eyebrow && 'mt-4',
        centered ? 'mx-auto max-w-4xl' : 'max-w-5xl',
      ]}
    >
      <slot />
    </h1>
    {
      description && (
        <p class:list={['mt-5 max-w-2xl text-[1.0625rem] md:text-lg', centered && 'mx-auto']}>{description}</p>
      )
    }
    <slot name="after" />
  </Container>
</section>
