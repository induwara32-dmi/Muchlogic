---
import Icon from '../ui/Icon.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel: Heading = 'h3' } = Astro.props;
---

<article
  class="group relative flex h-full gap-4 p-5 transition-colors duration-150 hover:bg-surface-alt sm:flex-col sm:gap-0 sm:p-8"
>
  <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-primary-soft text-primary sm:size-12">
    <Icon name={service.icon} size={22} />
  </span>
  <div class="flex min-w-0 flex-1 flex-col">
    <Heading class="text-base sm:mt-5 sm:text-lg">{service.title}</Heading>
    <p class="mt-1 flex-1 sm:mt-2">{service.summary}</p>
    <a
      href={`/services#${service.slug}`}
      class="mt-3 inline-flex items-center gap-1.5 self-start text-[0.9375rem] font-semibold text-primary after:absolute after:inset-0 after:content-[''] hover:text-primary-hover sm:mt-6"
    >
      Learn more<span class="sr-only"> about {service.title}</span>
      <Icon
        name="arrow-right"
        size={16}
        class="transition-transform duration-150 group-hover:translate-x-0.5"
      />
    </a>
  </div>
</article>
