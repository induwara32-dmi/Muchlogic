---
import Icon from '../ui/Icon.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel: Heading = 'h3' } = Astro.props;
---

<article
  class="group relative flex h-full flex-col p-7 transition-colors duration-150 hover:bg-surface-alt sm:p-8"
>
  <span class="inline-flex size-12 items-center justify-center rounded-xl bg-primary-soft text-primary">
    <Icon name={service.icon} size={24} />
  </span>
  <Heading class="mt-5 text-lg">{service.title}</Heading>
  <p class="mt-2 flex-1">{service.summary}</p>
  <a
    href={`/services#${service.slug}`}
    class="mt-6 inline-flex items-center gap-1.5 self-start text-[0.9375rem] font-semibold text-primary after:absolute after:inset-0 after:content-[''] hover:text-primary-hover"
  >
    Learn more<span class="sr-only"> about {service.title}</span>
    <Icon
      name="arrow-right"
      size={16}
      class="transition-transform duration-150 group-hover:translate-x-0.5"
    />
  </a>
</article>
