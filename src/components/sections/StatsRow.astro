---
// Renders nothing until src/data/stats.ts has real data.
import { stats } from '../../data/stats';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{
  stats.length > 0 && (
    <dl
      class:list={[
        'grid grid-cols-2 gap-y-8 lg:grid-cols-4 lg:divide-x lg:divide-line',
        className,
      ]}
    >
      {stats.map((stat) => (
        <div class="flex flex-col-reverse gap-1 lg:px-8 lg:first:pl-0">
          <dt class="text-sm font-medium text-body">{stat.label}</dt>
          <dd class="text-3xl font-semibold tracking-heading text-ink md:text-4xl">{stat.value}</dd>
        </div>
      ))}
    </dl>
  )
}
