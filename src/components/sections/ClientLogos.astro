---
// Renders nothing until src/data/clientLogos.ts has real clients.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { clientLogos } from '../../data/clientLogos';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const logoFiles = import.meta.glob<ImageMetadata>('../../assets/clients/*.{svg,png,webp,avif}', {
  eager: true,
  import: 'default',
});

const logos = clientLogos
  .map((client) => ({ ...client, src: logoFiles[`../../assets/clients/${client.logo}`] }))
  .filter((client): client is typeof client & { src: ImageMetadata } => Boolean(client.src));
---

{
  logos.length > 0 && (
    <div class:list={[className]}>
      <h2 class="text-sm font-medium text-body">Trusted by</h2>
      <ul class="mt-5 flex flex-wrap items-center gap-x-12 gap-y-6">
        {logos.map((client) => (
          <li>
            <Image
              src={client.src}
              alt={client.name}
              height={40}
              class="h-9 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0"
              loading="lazy"
            />
          </li>
        ))}
      </ul>
    </div>
  )
}
