---
/** Leadership cards from team.ts. Renders nothing while the list is empty. */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { team } from '../../data/team';
import { getTeamPhoto } from '../../lib/images';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join('');

const members = team.map((member) => ({ ...member, photoSrc: getTeamPhoto(member.photo) }));
---

{
  members.length > 0 && (
    <ul class:list={['flex flex-wrap justify-center gap-6', className]}>
      {members.map((member, i) => (
        <li
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
          class="flex w-full flex-col gap-6 rounded-card border border-line bg-surface p-6 sm:flex-row sm:p-7 md:w-[calc(50%-0.75rem)]"
        >
          {member.photoSrc ? (
            <Image
              src={member.photoSrc}
              alt={`Portrait of ${member.name}`}
              width={320}
              height={320}
              loading="lazy"
              class="size-32 shrink-0 rounded-card object-cover sm:size-40"
            />
          ) : (
            <span
              aria-hidden="true"
              class="inline-flex size-32 shrink-0 items-center justify-center rounded-card bg-primary-soft text-4xl font-bold tracking-display text-primary sm:size-40"
            >
              {initials(member.name)}
            </span>
          )}
          <div class="flex flex-col sm:min-h-40">
            <h3 class="text-xl">{member.name}</h3>
            <p class="mt-1 text-sm font-bold uppercase tracking-widest text-primary">{member.role}</p>
            {member.bio && <p class="mt-3">{member.bio}</p>}
            {member.linkedin && (
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex size-11 items-center justify-center self-start rounded-pill border border-line text-ink transition-colors hover:border-primary hover:text-primary sm:mt-auto"
              >
                <Icon name="linkedin" size={18} />
                <span class="sr-only">{`${member.name} on LinkedIn (opens in a new tab)`}</span>
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}
