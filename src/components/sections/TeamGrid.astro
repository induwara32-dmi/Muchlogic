---
/** Leadership cards from team.ts. Renders nothing while the list is empty. */
import { Image } from 'astro:assets';
import Icon, { type IconName } from '../ui/Icon.astro';
import { team } from '../../data/team';
import { isPlaceholder } from '../../data/site';
import { getTeamPhoto } from '../../lib/images';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((part) => part.length > 1) // skip middle initials like "C"
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join('');

const usable = (value: string | undefined): value is string => Boolean(value) && !isPlaceholder(value!);

interface ContactLink {
  icon: IconName;
  href: string;
  label: string;
  external?: boolean;
}

const members = team.map((member) => {
  const links: ContactLink[] = [];
  if (usable(member.linkedin)) {
    links.push({ icon: 'linkedin', href: member.linkedin, label: `${member.name} on LinkedIn`, external: true });
  }
  if (usable(member.email)) {
    links.push({ icon: 'mail', href: `mailto:${member.email}`, label: `Email ${member.name}` });
  }
  if (member.phone && usable(member.phone.e164)) {
    links.push({ icon: 'phone', href: `tel:${member.phone.e164}`, label: `Call ${member.name} on ${member.phone.display}` });
  }
  return { ...member, links, photoSrc: getTeamPhoto(member.photo) };
});
---

{
  members.length > 0 && (
    <ul class:list={['flex flex-wrap gap-6', className]}>
      {members.map((member) => (
        <li
          data-reveal
          class="flex w-full flex-col gap-6 rounded-card border border-line bg-surface p-6 shadow-card sm:flex-row sm:p-7 md:w-[calc(50%-0.75rem)] lg:max-w-[34rem]"
        >
          {member.photoSrc ? (
            <Image
              src={member.photoSrc}
              alt={`Portrait of ${member.name}`}
              width={320}
              height={320}
              loading="lazy"
              class="size-32 shrink-0 rounded-card object-cover sm:size-40"
            />
          ) : (
            <span
              aria-hidden="true"
              class="inline-flex size-32 shrink-0 items-center justify-center rounded-card bg-primary-soft text-4xl font-semibold tracking-display text-primary sm:size-40"
            >
              {initials(member.name)}
            </span>
          )}
          <div class="flex min-w-0 flex-col sm:min-h-40">
            <h3 class="text-xl">{member.name}</h3>
            <p class="mt-1 text-[0.8125rem] font-semibold uppercase tracking-[0.12em] text-primary">{member.role}</p>
            {usable(member.bio) && <p class="mt-3">{member.bio}</p>}
            {member.links.length > 0 && (
              <ul class="mt-5 flex gap-3 sm:mt-auto sm:pt-5" aria-label={`Contact ${member.name}`}>
                {member.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-label={link.external ? `${link.label} (opens in a new tab)` : link.label}
                      title={link.label}
                      {...(link.external && { target: '_blank', rel: 'noopener noreferrer' })}
                      class="inline-flex size-tap items-center justify-center rounded-control bg-primary-soft text-primary transition-colors duration-150 hover:bg-primary hover:text-white focus-visible:bg-primary focus-visible:text-white"
                    >
                      <Icon name={link.icon} size={18} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}
