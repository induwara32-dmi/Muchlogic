---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site, phoneHref } from '../../data/site';
---

<section class="hero-bg overflow-hidden text-dark-muted" aria-labelledby="final-cta-title">
  <!-- Decorative: large soft orange glow and an oversized faint arrow behind the heading -->
  <div aria-hidden="true" class="final-cta-glow pointer-events-none absolute -z-10"></div>
  <svg
    aria-hidden="true"
    viewBox="0 0 200 120"
    fill="none"
    class="pointer-events-none absolute top-1/2 -right-12 -z-10 w-[17rem] -translate-y-1/2 text-white/[0.045] md:right-[4%] md:w-[20rem] lg:right-[33%] lg:w-[22rem]"
  >
    <path d="M8 60h170M128 12l50 48-50 48" stroke="currentColor" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <Container class="grid gap-8 py-14 md:py-16 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-16">
    <div data-reveal class="max-w-2xl">
      <h2
        id="final-cta-title"
        class="text-section text-white"
      >
        Ready to grow? Let’s talk.
      </h2>
      <p class="mt-4 max-w-prose text-lead">
        Tell us about your project. We’ll come back with a clear plan, timeline and quote.
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <Button href="/contact" variant="light" size="lg" block>Start a project</Button>
      <a
        href={phoneHref}
        class="inline-flex min-h-12 items-center justify-center gap-2.5 rounded-control border border-white/20 bg-white/10 px-6 font-medium text-white transition-[background-color,transform] duration-150 hover:bg-white/15 active:scale-[0.98]"
      >
        <Icon name="phone" size={18} class="text-primary-on-dark" />
        <span class="sr-only">Call us on</span>
        {site.phone.display}
      </a>
    </div>
  </Container>
</section>

<style>
  .final-cta-glow {
    left: -10%;
    top: 50%;
    width: min(60rem, 120%);
    aspect-ratio: 2 / 1;
    translate: 0 -50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-primary-on-dark) 22%, transparent), transparent);
  }
</style>
