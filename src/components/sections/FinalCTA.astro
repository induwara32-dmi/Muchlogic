---
import Section, { type SectionTone } from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site, phoneHref } from '../../data/site';

interface Props {
  tone?: SectionTone;
}

const { tone = 'white' } = Astro.props;
---

<Section tone={tone} aria-labelledby="final-cta-title">
  <div data-reveal class="mx-auto max-w-3xl text-center">
    <h2
      id="final-cta-title"
      class="text-[2.5rem] leading-[1.05] tracking-display md:text-6xl lg:text-7xl"
    >
      Ready to grow?{' '}
      <span class="block text-primary">Let’s talk.</span>
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg md:text-xl">
      Tell us about your project. We’ll come back with a clear plan, timeline and quote.
    </p>
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
      <Button href="/contact" size="lg" icon="arrow-right" block>Start a project</Button>
      <a
        href={phoneHref}
        class="inline-flex min-h-12 w-full items-center justify-center gap-2.5 rounded-pill border border-line bg-surface px-6 font-semibold text-ink transition-colors hover:border-ink sm:w-auto"
      >
        <Icon name="phone" size={18} class="text-primary" />
        <span class="sr-only">Call us on</span>
        {site.phone.display}
      </a>
    </div>
  </div>
</Section>
