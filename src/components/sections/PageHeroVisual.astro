---
/**
 * Small decorative illustration in the free space right of an inner-page hero headline (xl and up;
 * absolutely positioned, so it never changes the text layout).
 * One per page, matched to its topic, and deliberately lighter than the Home hero visual:
 * light cards, thin lines, a single orange accent. Inline SVG, aria-hidden, fixed viewBox.
 */
interface Props {
  kind: 'services' | 'work' | 'about' | 'contact';
}

const { kind } = Astro.props;
---

<div aria-hidden="true" class="page-hero-visual pointer-events-none absolute top-1/2 right-8 hidden w-[17rem] -translate-y-1/2 select-none xl:block 2xl:w-[19rem]">
  <svg viewBox="0 0 440 320" class="block h-auto w-full" fill="none">
    <!-- Service modules: a grid of tiles, one highlighted, joined into one platform -->
    {
      kind === 'services' && (
        <g>
          <rect x="48" y="36" width="344" height="248" rx="20" fill="#fff" stroke="#dbe1e8" />
          {[0, 1, 2].map((c) =>
            [0, 1].map((r) => {
              const x = 72 + c * 104;
              const y = 60 + r * 104;
              const hot = c === 1 && r === 0;
              return (
                <g>
                  <rect x={x} y={y} width="88" height="88" rx="14" fill={hot ? '#c2410c' : '#f4f6f9'} stroke={hot ? 'none' : '#dbe1e8'} />
                  <rect x={x + 16} y={y + 18} width="24" height="24" rx="7" fill={hot ? '#fff' : '#dbe1e8'} opacity={hot ? 0.9 : 1} />
                  <rect x={x + 16} y={y + 56} width="52" height="7" rx="3.5" fill={hot ? '#fff' : '#dbe1e8'} opacity={hot ? 0.75 : 1} />
                </g>
              );
            }),
          )}
          <circle cx="392" cy="36" r="18" fill="#fdf1ea" stroke="#c2410c" stroke-width="2" />
          <path d="M384 36h16M392 28v16" stroke="#c2410c" stroke-width="2.5" stroke-linecap="round" />
        </g>
      )
    }
    <!-- A shipped project: browser window with a site layout, plus an overlapping phone -->
    {
      kind === 'work' && (
        <g>
          <rect x="24" y="40" width="320" height="230" rx="16" fill="#fff" stroke="#dbe1e8" />
          <path d="M40 40h288a16 16 0 0 1 16 16v16H24V56a16 16 0 0 1 16-16z" fill="#f4f6f9" />
          <circle cx="44" cy="56" r="4.5" fill="#dbe1e8" /><circle cx="60" cy="56" r="4.5" fill="#dbe1e8" /><circle cx="76" cy="56" r="4.5" fill="#dbe1e8" />
          <rect x="48" y="96" width="150" height="14" rx="7" fill="#0b1b2e" opacity=".85" />
          <rect x="48" y="120" width="120" height="8" rx="4" fill="#dbe1e8" />
          <rect x="48" y="146" width="72" height="22" rx="8" fill="#c2410c" />
          <rect x="216" y="92" width="104" height="80" rx="10" fill="#fdf1ea" />
          <path d="M232 156l22-26 16 18 12-12 22 20" stroke="#fb923c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          {[0, 1, 2].map((i) => (
            <rect x={48 + i * 92} y="192" width="80" height="54" rx="10" fill="#f4f6f9" stroke="#dbe1e8" />
          ))}
          <rect x="304" y="92" width="112" height="208" rx="20" fill="#fff" stroke="#dbe1e8" stroke-width="1.5" />
          <rect x="342" y="102" width="36" height="6" rx="3" fill="#dbe1e8" />
          <rect x="318" y="122" width="84" height="56" rx="10" fill="#fdf1ea" />
          <rect x="318" y="190" width="64" height="8" rx="4" fill="#0b1b2e" opacity=".85" />
          <rect x="318" y="206" width="78" height="6" rx="3" fill="#dbe1e8" />
          <rect x="318" y="218" width="54" height="6" rx="3" fill="#dbe1e8" />
          <rect x="318" y="248" width="84" height="26" rx="9" fill="#c2410c" />
        </g>
      )
    }
    <!-- One clear path: plan, build, support — three steps joined by a dashed route -->
    {
      kind === 'about' && (
        <g>
          <path d="M80 236C140 236 150 120 220 120S300 72 360 72" stroke="#dbe1e8" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round" />
          {[
            [80, 236, false],
            [220, 120, false],
            [360, 72, true],
          ].map(([x, y, last]) => (
            <g>
              <circle cx={x as number} cy={y as number} r="34" fill={last ? '#c2410c' : '#fff'} stroke={last ? 'none' : '#dbe1e8'} />
              {last ? (
                <path d={`M${(x as number) - 12} ${y} l8 8 16-16`} stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
              ) : (
                <circle cx={x as number} cy={y as number} r="9" fill="#fb923c" />
              )}
            </g>
          ))}
          <rect x="40" y="284" width="80" height="8" rx="4" fill="#dbe1e8" />
          <rect x="180" y="168" width="80" height="8" rx="4" fill="#dbe1e8" />
          <rect x="320" y="120" width="80" height="8" rx="4" fill="#dbe1e8" />
        </g>
      )
    }
    <!-- A conversation: incoming message, reply bubble and a send button -->
    {
      kind === 'contact' && (
        <g>
          <rect x="60" y="40" width="320" height="240" rx="20" fill="#fff" stroke="#dbe1e8" />
          <rect x="84" y="68" width="190" height="52" rx="16" fill="#f4f6f9" />
          <rect x="102" y="84" width="130" height="7" rx="3.5" fill="#dbe1e8" />
          <rect x="102" y="99" width="90" height="7" rx="3.5" fill="#dbe1e8" />
          <rect x="166" y="136" width="190" height="52" rx="16" fill="#c2410c" />
          <rect x="184" y="152" width="140" height="7" rx="3.5" fill="#fff" opacity=".85" />
          <rect x="184" y="167" width="96" height="7" rx="3.5" fill="#fff" opacity=".85" />
          <rect x="84" y="204" width="76" height="34" rx="14" fill="#f4f6f9" />
          <circle cx="104" cy="221" r="4" fill="#a9b7c8" /><circle cx="122" cy="221" r="4" fill="#a9b7c8" /><circle cx="140" cy="221" r="4" fill="#a9b7c8" />
          <circle cx="380" cy="40" r="26" fill="#fdf1ea" stroke="#c2410c" stroke-width="2" />
          <path d="M368 41l24-11-8 24-5-9-11-4z" fill="#c2410c" />
        </g>
      )
    }
  </svg>
</div>
