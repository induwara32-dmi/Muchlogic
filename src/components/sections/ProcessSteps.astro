---
/**
 * Numbered steps with a rule above each one.
 * layout="responsive" (default): stacked on mobile, 2 columns on tablet, one row on desktop.
 * layout="vertical": a single column at every size (for narrow columns, e.g. Contact).
 * Defaults to the shared process from process.ts; pass `items` for other step lists.
 */
import { processSteps, type ProcessStep } from '../../data/process';

interface Props {
  items?: ProcessStep[];
  layout?: 'responsive' | 'vertical';
  /** Heading level for step titles */
  headingLevel?: 'h3' | 'h4';
  class?: string;
}

const {
  items = processSteps,
  layout = 'responsive',
  headingLevel: Heading = 'h3',
  class: className,
} = Astro.props;

const vertical = layout === 'vertical';
---

<ol
  class:list={[
    vertical
      ? 'divide-y divide-line border-y border-line'
      : 'grid gap-x-8 gap-y-7 md:grid-cols-2 md:gap-y-10 lg:grid-cols-[repeat(var(--steps),minmax(0,1fr))]',
    className,
  ]}
  style={`--steps:${items.length}`}
>
  {
    items.map((step, i) => (
      <li
        data-reveal
        class:list={[vertical ? 'grid grid-cols-[3.25rem_minmax(0,1fr)] gap-x-0 py-5' : 'border-t-2 border-line pt-5']}
      >
        <span class="inline-flex size-9 items-center justify-center rounded-xl bg-primary-soft text-sm font-semibold tabular-nums text-primary" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class:list={[!vertical && 'mt-3']}>
          <Heading class="text-lg">{step.title}</Heading>
          <p class="mt-2">{step.description}</p>
        </div>
      </li>
    ))
  }
</ol>
