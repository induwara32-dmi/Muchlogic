# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=hello@muchlogic.com

# Sender address. onboarding@resend.dev works for testing only (it can only send to your own Resend account email).
# For production, verify muchlogic.com in Resend and use e.g. website@muchlogic.com.
CONTACT_FROM_EMAIL=onboarding@resend.dev
